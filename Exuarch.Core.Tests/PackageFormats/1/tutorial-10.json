{
  "name": "Tutorial 10 \u00B7 Taking an interrupt",
  "description": "Where the Taking an interrupt tutorial starts: the machine as Reading the keypad leaves it.",
  "readme": "# Tutorial 10 \u00B7 Taking an interrupt\n\nThis is the machine the [Taking an interrupt](exuarch:guide/taking-an-interrupt) tutorial starts from, built step by step as the tutorials before it say, ending with [Reading the keypad](exuarch:guide/reading-the-keypad). Load it if you skipped a tutorial or lost your own machine, and carry on from there.\n\nIt is an example like the others: change it as much as you like, and **Reset** brings it back the way it starts. To keep your work separately, make a copy with **New\u2026**, *Copy of the current machine*.",
  "machine": {
    "name": "Tutorial 10 \u00B7 Taking an interrupt",
    "buses": [
      {
        "id": "main",
        "layout": { "x": 0, "y": 222 }
      }
    ],
    "devices": [
      {
        "id": "pc",
        "type": "register",
        "name": "PC",
        "bus": "main",
        "layout": { "x": 30, "y": 40 }
      },
      {
        "id": "ir",
        "type": "instructionRegister",
        "name": "IR",
        "bus": "main",
        "layout": { "x": 870, "y": 278 }
      },
      {
        "id": "mem",
        "type": "ram",
        "name": "MEMORY",
        "bus": "main",
        "layout": { "x": 240, "y": 40 }
      },
      {
        "id": "status",
        "type": "statusRegister",
        "name": "STATUS",
        "bus": "main",
        "layout": { "x": 450, "y": 278 }
      },
      {
        "id": "clk",
        "type": "clock",
        "name": "CLOCK",
        "layout": { "x": 1080, "y": 40 }
      },
      {
        "id": "lcd",
        "type": "display",
        "bus": "main",
        "layout": { "x": 30, "y": 278 }
      },
      {
        "id": "a",
        "type": "register",
        "bus": "main",
        "layout": { "x": 660, "y": 40 }
      },
      {
        "id": "b",
        "type": "register",
        "bus": "main",
        "layout": { "x": 240, "y": 278 }
      },
      {
        "id": "alu",
        "type": "alu",
        "bus": "main",
        "connections": { "a": "a", "b": "b", "status": "status" },
        "layout": { "x": 450, "y": 40 }
      },
      {
        "id": "tmp",
        "type": "register",
        "bus": "main",
        "layout": { "x": 660, "y": 278 }
      },
      {
        "id": "sp",
        "type": "register",
        "bus": "main",
        "layout": { "x": 870, "y": 40 }
      },
      {
        "id": "keypad",
        "type": "keypad",
        "bus": "main",
        "layout": { "x": 1080, "y": 278 }
      }
    ],
    "decoder": {
      "status": "status",
      "instructionRegister": "ir",
      "microcode": {
        "name": "Mine microcode",
        "fetch": {
          "mnemonic": "FETCH",
          "description": "Load the opcode at the program counter into the instruction register and step past it",
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "ir.load", "pc.inc"]
            }
          ]
        },
        "instructions": [
          {
            "mnemonic": "HLT",
            "operands": 0,
            "steps": [
              {
                "signals": ["clk.disable"]
              }
            ]
          },
          {
            "mnemonic": "NOP",
            "operands": 0,
            "steps": [
              {
                "signals": ["ir.reset"]
              }
            ]
          },
          {
            "mnemonic": "JMP",
            "operands": 1,
            "operandTypes": ["address"],
            "steps": [
              {
                "signals": ["pc.output", "mem.loadmar"]
              },
              {
                "signals": ["mem.output", "pc.load", "ir.reset"]
              }
            ]
          },
          {
            "mnemonic": "OUT",
            "operands": 1,
            "operandTypes": ["value"],
            "steps": [
              {
                "signals": ["pc.output", "mem.loadmar"]
              },
              {
                "signals": ["mem.output", "lcd.load", "pc.inc", "ir.reset"]
              }
            ]
          },
          {
            "mnemonic": "LAI",
            "operands": 1,
            "operandTypes": ["value"],
            "steps": [
              {
                "signals": ["pc.output", "mem.loadmar"]
              },
              {
                "signals": ["mem.output", "a.load", "pc.inc", "ir.reset"]
              }
            ]
          },
          {
            "mnemonic": "LBI",
            "operands": 1,
            "operandTypes": ["value"],
            "steps": [
              {
                "signals": ["pc.output", "mem.loadmar"]
              },
              {
                "signals": ["mem.output", "b.load", "pc.inc", "ir.reset"]
              }
            ]
          },
          {
            "mnemonic": "ADD",
            "operands": 0,
            "steps": [
              {
                "signals": ["alu.add", "a.load", "ir.reset"]
              }
            ]
          },
          {
            "mnemonic": "OUTA",
            "operands": 0,
            "steps": [
              {
                "signals": ["a.output", "lcd.load", "ir.reset"]
              }
            ]
          },
          {
            "mnemonic": "SUB",
            "operands": 0,
            "steps": [
              {
                "signals": ["alu.sub", "a.load", "ir.reset"]
              }
            ]
          },
          {
            "mnemonic": "CMP",
            "operands": 0,
            "steps": [
              {
                "signals": ["alu.cmp", "ir.reset"]
              }
            ]
          },
          {
            "mnemonic": "JNZ",
            "operands": 1,
            "operandTypes": ["address"],
            "steps": [
              {
                "signals": ["pc.output", "mem.loadmar"]
              },
              {
                "when": { "Z": false },
                "signals": ["mem.output", "pc.load", "ir.reset"]
              },
              {
                "when": { "Z": true },
                "signals": ["pc.inc", "ir.reset"]
              }
            ]
          },
          {
            "mnemonic": "CALL",
            "operands": 1,
            "operandTypes": ["address"],
            "steps": [
              {
                "signals": ["pc.output", "mem.loadmar"]
              },
              {
                "signals": ["mem.output", "tmp.load", "pc.inc", "sp.dec"]
              },
              {
                "signals": ["sp.output", "mem.loadmar"]
              },
              {
                "signals": ["pc.output", "mem.load"]
              },
              {
                "signals": ["tmp.output", "pc.load", "ir.reset"]
              }
            ]
          },
          {
            "mnemonic": "RET",
            "operands": 0,
            "steps": [
              {
                "signals": ["sp.output", "mem.loadmar"]
              },
              {
                "signals": ["mem.output", "pc.load", "sp.inc", "ir.reset"]
              }
            ]
          },
          {
            "mnemonic": "KEYS",
            "operands": 0,
            "steps": [
              {
                "signals": ["keypad.output", "a.load", "ir.reset"]
              }
            ]
          }
        ]
      },
      "layout": { "x": 1290, "y": 40 }
    },
    "halt": "clk",
    "programMemory": "mem"
  },
  "programs": [
    {
      "name": "Echo",
      "description": "The program Reading the keypad ends with",
      "source": "wait:   KEYS\n        LBI   0\n        CMP\n        JNZ   got\n        JMP   wait\n\ngot:    LBI   16\n        CMP\n        JNZ   show\n        HLT\n\nshow:   LBI   \u00270\u0027\n        ADD\n        OUTA\n        JMP   wait"
    }
  ]
}
