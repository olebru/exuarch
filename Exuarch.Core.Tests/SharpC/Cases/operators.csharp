class O
{
    static void Main()
    {
        int a = 100, b = -7;
        int c = (a & 0xFF) | (b ^ 3) << 2;
        c >>= 1;
        c = c >>> 3;
        bool t = a > b && !(a == b) || b >= 0;
        int d = t ? a % 7 : ~b;
        a -= 1; a *= 2; a /= 3; a %= 5; a &= 6; a |= 1; a ^= 2; a <<= 1;
        Console.Write(c + d + a);
        Console.Write(-a);
        Console.Write(a != b);
        Console.Write(a <= b);
    }
}
