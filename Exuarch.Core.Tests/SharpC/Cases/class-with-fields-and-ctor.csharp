class Point
{
    public int X, Y;
    public Point(int x, int y) { X = x; Y = y; }
    public int Sum() { return X + Y; }
    public void Move(int dx) { X += dx; }
}
class Program
{
    static void Main()
    {
        Point p = new Point(3, 4);
        p.Move(10);
        Console.WriteLine(p.Sum());
        Console.Write(p.X);
    }
}
