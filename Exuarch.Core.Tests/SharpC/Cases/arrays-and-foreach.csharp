class A
{
    static void Main()
    {
        int[] a = new int[5];
        for (int i = 0; i < a.Length; i++) a[i] = i * i;
        int sum = 0;
        foreach (int v in a) sum += v;
        Console.WriteLine(sum);
        bool[] flags = new bool[3];
        flags[1] = true;
        char[] cs = { 'a', 'b' };
        Console.Write(cs[1]);
        Console.Write(flags[1]);
    }
}
