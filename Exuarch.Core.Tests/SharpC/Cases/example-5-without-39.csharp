// A Sierpinski triangle: a pixel is li where x AND y has no bits set
using System;

class Sierpinski
{
    const int Size = 256;

    static void Main()
    {
        Screen.Clear();
        for (int y = 0; y < Size; y++)
        {
            Screen.MoveTo(192, y + 112);
            for (int x = 0; x < Size; x++)
            {
                int colour = (x & y) == 0 ? Screen.Rgb(x, y, 255 - x) : 0;
                Screen.Put(colour);
            }
        }
        Console.Write("Sierpinski, drawn");
    }
}
