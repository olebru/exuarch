using System;
class Node
{
    int value;
    Node next;
    public Node(int v, Node n) { value = v; next = n; }
    public int Count() { int c = 0; Node p = this; while (p != null) { c++; p = p.next; } return c; }
}
class P
{
    static void Main()
    {
        Node list = null;
        for (int i = 0; i < 4; i++) list = new Node(i, list);
        Console.Write(list.Count());
        var arr = new Node[2];
        arr[0] = list;
        Console.Write(arr[0] == list);
    }
}
