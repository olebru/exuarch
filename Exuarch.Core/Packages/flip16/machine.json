{
  "name": "FLIP-16",
  "buses": [
    {
      "id": "main",
      "layout": { "x": 0, "y": 222 }
    },
    {
      "id": "list",
      "layout": { "x": 0, "y": 596 }
    },
    {
      "id": "video",
      "layout": { "x": 0, "y": 1000 }
    }
  ],
  "devices": [
    {
      "id": "pc",
      "type": "register",
      "name": "PC",
      "bus": "main",
      "layout": { "x": 30, "y": 40 }
    },
    {
      "id": "ir",
      "type": "instructionRegister",
      "name": "IR",
      "bus": "main",
      "layout": { "x": 1080, "y": 40 }
    },
    {
      "id": "mem",
      "type": "ram",
      "name": "MEMORY",
      "bus": "main",
      "parameters": { "size": 4096 },
      "layout": { "x": 30, "y": 278 }
    },
    {
      "id": "flags",
      "type": "statusRegister",
      "name": "FLAGS",
      "bus": "main",
      "layout": { "x": 660, "y": 40 }
    },
    {
      "id": "sp",
      "type": "register",
      "name": "SP",
      "bus": "main",
      "layout": { "x": 450, "y": 278 }
    },
    {
      "id": "a",
      "type": "register",
      "name": "A",
      "bus": "main",
      "layout": { "x": 240, "y": 40 }
    },
    {
      "id": "clk",
      "type": "clock",
      "name": "CLOCK",
      "layout": { "x": 1290, "y": 40 }
    },
    {
      "id": "b",
      "type": "register",
      "name": "B",
      "bus": "main",
      "layout": { "x": 660, "y": 278 }
    },
    {
      "id": "t",
      "type": "register",
      "name": "ALU OPERAND",
      "bus": "main",
      "layout": { "x": 870, "y": 278 }
    },
    {
      "id": "alu",
      "type": "alu",
      "name": "ALU",
      "bus": "main",
      "connections": { "a": "a", "b": "t", "status": "flags" },
      "layout": { "x": 450, "y": 40 }
    },
    {
      "id": "mac",
      "type": "mac",
      "name": "MULTIPLY-ACCUMULATE",
      "bus": "main",
      "layout": { "x": 1290, "y": 278 }
    },
    {
      "id": "lcd",
      "type": "display",
      "name": "LCD",
      "bus": "main",
      "parameters": { "columns": 32, "rows": 4 },
      "layout": { "x": 870, "y": 40 }
    },
    {
      "id": "bridge",
      "type": "dualPortRegister",
      "name": "TO THE LIST BUS",
      "buses": { "a": "main", "b": "list" },
      "layout": { "x": 1080, "y": 278 }
    },
    {
      "id": "lmem",
      "type": "ram",
      "name": "TRIANGLE LIST",
      "bus": "list",
      "parameters": { "size": 4096 },
      "layout": { "x": 30, "y": 444 }
    },
    {
      "id": "rast",
      "type": "rasterizer",
      "name": "RASTERIZER",
      "buses": { "host": "main", "list": "list", "video": "video" },
      "connections": { "screen": "fb", "depth": "zb", "memory": "lmem" },
      "layout": { "x": 240, "y": 652 }
    },
    {
      "id": "fb",
      "type": "doubleFramebuffer",
      "name": "SCREEN",
      "bus": "video",
      "layout": { "x": 30, "y": 848 }
    },
    {
      "id": "zb",
      "type": "depthBuffer",
      "name": "DEPTH",
      "bus": "video",
      "layout": { "x": 450, "y": 848 }
    },
    {
      "id": "rtc",
      "type": "rtc",
      "name": "FRAME CLOCK",
      "bus": "main",
      "parameters": { "interval": 100 },
      "layout": { "x": 1500, "y": 278 }
    },
    {
      "id": "pic",
      "type": "interruptController",
      "name": "BEATS",
      "bus": "main",
      "connections": { "irq0": "rtc" },
      "layout": { "x": 1710, "y": 278 }
    }
  ],
  "decoder": {
    "status": "flags",
    "instructionRegister": "ir",
    "microcode": {
      "name": "FLIP-16 microcode",
      "fetch": {
        "mnemonic": "FETCH",
        "description": "Load the opcode at the address in PC from MEMORY into IR and step PC past it; there is no interrupt check",
        "steps": [
          {
            "signals": ["pc.output", "mem.loadmar"]
          },
          {
            "signals": ["mem.output", "ir.load", "pc.inc"]
          }
        ]
      },
      "instructions": [
        {
          "mnemonic": "NOP",
          "description": "Do nothing; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "HLT",
          "description": "Stop the clock, halting the machine; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["clk.disable"]
            }
          ]
        },
        {
          "mnemonic": "LDI",
          "description": "A = the value after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "a.load"]
            }
          ]
        },
        {
          "mnemonic": "LBI",
          "description": "B = the value after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "b.load"]
            }
          ]
        },
        {
          "mnemonic": "LBA",
          "description": "B = the address after the opcode, for walking memory with LDX and STX (the same steps as LBI); flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "b.load"]
            }
          ]
        },
        {
          "mnemonic": "LDA",
          "description": "A = the MEMORY cell at the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mem.loadmar", "pc.inc"]
            },
            {
              "signals": ["mem.output", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "STA",
          "description": "Store A in the MEMORY cell at the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mem.loadmar", "pc.inc"]
            },
            {
              "signals": ["a.output", "mem.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "LDX",
          "description": "A = the MEMORY cell at the address in B; B and flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "STX",
          "description": "Store A in the MEMORY cell at the address in B; B and flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "mem.loadmar"]
            },
            {
              "signals": ["a.output", "mem.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "TAB",
          "description": "B = A; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.output", "b.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "TBA",
          "description": "A = B; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "INA",
          "description": "A = A \u002B 1, wrapping from FFFF to 0; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "INB",
          "description": "B = B \u002B 1, wrapping from FFFF to 0; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "DEB",
          "description": "B = B - 1, wrapping from 0 to FFFF; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.dec", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "ADD",
          "description": "A = A \u002B B; sets Z and N, C on carry out and V on signed overflow",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load"]
            },
            {
              "signals": ["alu.add", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "SUB",
          "description": "A = A - B; sets Z and N, C if A \u003C B unsigned (a borrow) and V on signed overflow",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load"]
            },
            {
              "signals": ["alu.sub", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "AND",
          "description": "A = A AND B, bit by bit; sets Z and N, clears C and V",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load"]
            },
            {
              "signals": ["alu.and", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "ADDI",
          "description": "A = A \u002B the value after the opcode; sets Z and N, C on carry out and V on signed overflow",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.add", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "SUBI",
          "description": "A = A - the value after the opcode; sets Z and N, C if A \u003C the value unsigned (a borrow) and V on signed overflow",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.sub", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "ANDI",
          "description": "A = A AND the value after the opcode, bit by bit; sets Z and N, clears C and V",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.and", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "EORI",
          "description": "A = A XOR the value after the opcode, bit by bit; sets Z and N, clears C and V",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.eor", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "LSRI",
          "description": "A = A shifted right, filling with 0, by the low 4 bits of the value after the opcode (0-15); sets Z and N, C to the last bit shifted out (clear for a shift of 0), clears V",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.lsr", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "CMPI",
          "description": "Set the flags for A - the value after the opcode without changing A: Z if equal, C if A \u003C the value unsigned, N from bit 15 of the difference, V on signed overflow",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.cmp", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JMP",
          "description": "Jump to the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JEQ",
          "description": "Jump to the address after the opcode if Z is set (equal after CMPI); otherwise go on with the next instruction. Flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "Z": true },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "Z": true },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "Z": false },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JNE",
          "description": "Jump to the address after the opcode if Z is clear (not equal after CMPI); otherwise go on with the next instruction. Flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "Z": false },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "Z": false },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "Z": true },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JCS",
          "description": "Jump to the address after the opcode if C is set (A \u003C the value unsigned after CMPI, or a carry out of ADD); otherwise go on with the next instruction. Flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "C": true },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "C": true },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "C": false },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JCC",
          "description": "Jump to the address after the opcode if C is clear (A \u003E= the value unsigned after CMPI, or no carry out of ADD); otherwise go on with the next instruction. Flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "C": false },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "C": false },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "C": true },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "CALL",
          "description": "Push the address of the next instruction (SP is decremented first, then the address is stored at SP in MEMORY) and jump to the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar", "pc.inc"]
            },
            {
              "signals": ["mem.output", "t.load", "sp.dec"]
            },
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["pc.output", "mem.load"]
            },
            {
              "signals": ["t.output", "pc.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "RET",
          "description": "Return: PC = the MEMORY cell at SP, then SP is incremented; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.load", "sp.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "PSA",
          "description": "Push A: SP is decremented first, then A is stored at SP in MEMORY (a full descending stack); flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["sp.dec"]
            },
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["a.output", "mem.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "POA",
          "description": "Pop A: A = the MEMORY cell at SP, then SP is incremented; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "a.load", "sp.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "PSB",
          "description": "Push B: SP is decremented first, then B is stored at SP in MEMORY (a full descending stack); flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["sp.dec"]
            },
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["b.output", "mem.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "POB",
          "description": "Pop B: B = the MEMORY cell at SP, then SP is incremented; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "b.load", "sp.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "OUT",
          "description": "Print the low 8 bits of A as a character at the LCD cursor and move the cursor on (10 starts a new line, 13 goes to the line start; the LCD scrolls at the bottom); flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.output", "lcd.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "CLT",
          "description": "Clear the LCD to spaces and move its cursor to the top left; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["lcd.clear", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "CLS",
          "description": "Clear the back buffer of SCREEN to 0 (black), out of sight, and move its cursor to the top left; the picture shown is unchanged; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["fb.clear", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JMI",
          "description": "Jump to the address after the opcode if N is set (bit 15 of the last ALU result set: negative); otherwise go on with the next instruction. Flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "N": true },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "N": true },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "N": false },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JPL",
          "description": "Jump to the address after the opcode if N is clear (bit 15 of the last ALU result clear: positive or zero); otherwise go on with the next instruction. Flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "N": false },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "N": false },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "N": true },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "STL",
          "description": "Store A in the TRIANGLE LIST cell at the address in B through the bridge register, which is left holding A. Only while the rasterizer is idle: while it reads the list both drive the list bus at once",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "bridge.loada"]
            },
            {
              "signals": ["bridge.outputb", "lmem.loadmar"]
            },
            {
              "signals": ["a.output", "bridge.loada"]
            },
            {
              "signals": ["bridge.outputb", "lmem.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "GADR",
          "description": "Set the rasterizer\u0027s triangle list start address from A; it is taken at once, so a change mid-job moves the triangles not yet read. Flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.output", "rast.loadaddr", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "GCNT",
          "description": "Set the number of triangles the rasterizer draws, 12 list words each, from A; it is taken at once, even mid-job. Flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.output", "rast.loadcount", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "GO",
          "description": "Start the rasterizer if it is idle and its count is not 0 (otherwise ignored). It reads each triangle\u0027s x, y, z and RGB565 colour per corner and fills it, plotting a pixel only where its z is below the depth buffer\u0027s, while the CPU continues",
          "operands": 0,
          "steps": [
            {
              "signals": ["rast.start", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "GST",
          "description": "A = the rasterizer\u0027s status: 1 while it is busy, 0 when it is idle; flags unchanged, so follow with CMPI to branch",
          "operands": 0,
          "steps": [
            {
              "signals": ["rast.status", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "ZCLR",
          "description": "Fill the depth buffer with FFFF (the farthest depth) and move its cursor to the top left; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["zb.clear", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "MA",
          "description": "Set the multiply-accumulate unit\u0027s operand a to A, read as a signed 16-bit number; flags unchanged",
