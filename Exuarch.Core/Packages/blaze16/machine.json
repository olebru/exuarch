  "decoder": {
    "status": "flags",
    "instructionRegister": "ir",
    "microcode": {
      "name": "BLAZE-16 microcode",
      "opcodeBits": 6,
      "fields": [
        { "low": 7, "bits": 3 },
        { "low": 4, "bits": 3 },
        { "low": 1, "bits": 3 },
        { "low": 0, "bits": 10 }
      ],
      "fetch": {
        "mnemonic": "FETCH",
        "description": "Only after a reset: every other instruction fetches the next one in its own last ticks, on the instruction bus",
        "steps": [
          {
            "signals": ["pc.output", "pmem.loadmar"]
          },
          {
            "signals": ["pmem.output", "ir.load", "iw.load", "pc.inc"]
          }
        ]
      },
      "instructions": [
        {
          "mnemonic": "NOP",
          "description": "Do nothing: two ticks, which fetch the next instruction",
          "operands": 0,
          "steps": [
            {
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "ir.load", "iw.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "HLT",
          "description": "Stop the clock",
          "operands": 0,
          "steps": [
            {
              "signals": ["clk.disable"]
            }
          ]
        },
        {
          "mnemonic": "MOVI",
          "description": "Rd = value, from the cell after the word, over the bridge",
          "operands": 2,
          "operandTypes": ["register", "value"],
          "fields": [0],
          "steps": [
            {
              "signals": ["iw.field0", "rf.select", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "opr.loada", "pc.inc"]
            },
            {
              "signals": ["opr.outputb", "rf.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "ir.load", "iw.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "MOV",
          "description": "Rd = Rs; flags unchanged",
          "operands": 2,
          "operandTypes": ["register", "register"],
          "fields": [0, 1],
          "steps": [
            {
              "signals": ["iw.field1", "rf.select", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["rf.output", "x.load"]
            },
            {
              "signals": ["iw.field0", "rf.select"]
            },
            {
              "signals": ["x.output", "rf.load", "pmem.output", "ir.load", "iw.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "ADD",
          "description": "Rd = Rs \u002B Rt; sets the flags",
          "operands": 3,
          "operandTypes": ["register", "register", "register"],
          "fields": [0, 1, 2],
          "steps": [
            {
              "signals": ["iw.field1", "rf.select", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["rf.output", "x.load"]
            },
            {
              "signals": ["iw.field2", "rf.select"]
            },
            {
              "signals": ["rf.output", "y.load"]
            },
            {
              "signals": ["iw.field0", "rf.select"]
            },
            {
              "signals": ["alu.add", "rf.load", "pmem.output", "ir.load", "iw.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "SUB",
          "description": "Rd = Rs - Rt; sets the flags",
          "operands": 3,
          "operandTypes": ["register", "register", "register"],
          "fields": [0, 1, 2],
          "steps": [
            {
              "signals": ["iw.field1", "rf.select", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["rf.output", "x.load"]
            },
            {
              "signals": ["iw.field2", "rf.select"]
            },
            {
              "signals": ["rf.output", "y.load"]
            },
            {
              "signals": ["iw.field0", "rf.select"]
            },
            {
              "signals": ["alu.sub", "rf.load", "pmem.output", "ir.load", "iw.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "ADDI",
          "description": "Rd = Rs \u002B value; sets the flags",
          "operands": 3,
          "operandTypes": ["register", "register", "value"],
          "fields": [0, 1],
          "steps": [
            {
              "signals": ["iw.field1", "rf.select", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["rf.output", "x.load", "pmem.output", "opr.loada", "pc.inc"]
            },
            {
              "signals": ["opr.outputb", "y.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["iw.field0", "rf.select"]
            },
            {
              "signals": ["alu.add", "rf.load", "pmem.output", "ir.load", "iw.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "SUBI",
          "description": "Rd = Rs - value; sets the flags",
          "operands": 3,
          "operandTypes": ["register", "register", "value"],
          "fields": [0, 1],
          "steps": [
            {
              "signals": ["iw.field1", "rf.select", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["rf.output", "x.load", "pmem.output", "opr.loada", "pc.inc"]
            },
            {
              "signals": ["opr.outputb", "y.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["iw.field0", "rf.select"]
            },
            {
              "signals": ["alu.sub", "rf.load", "pmem.output", "ir.load", "iw.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "CMP",
          "description": "Set the flags from Rs - Rt",
          "operands": 2,
          "operandTypes": ["register", "register"],
          "fields": [0, 1],
          "steps": [
            {
              "signals": ["iw.field0", "rf.select", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["rf.output", "x.load"]
            },
            {
              "signals": ["iw.field1", "rf.select"]
            },
            {
              "signals": ["rf.output", "y.load"]
            },
            {
              "signals": ["alu.cmp", "pmem.output", "ir.load", "iw.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "CMPI",
          "description": "Set the flags from Rs - value",
          "operands": 2,
          "operandTypes": ["register", "value"],
          "fields": [0],
          "steps": [
            {
              "signals": ["iw.field0", "rf.select", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["rf.output", "x.load", "pmem.output", "opr.loada", "pc.inc"]
            },
            {
              "signals": ["opr.outputb", "y.load", "pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["alu.cmp", "pmem.output", "ir.load", "iw.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "B",
          "description": "Branch to the address in the word\u0027s 10 bit field",
          "operands": 1,
          "operandTypes": ["address"],
          "fields": [3],
          "steps": [
            {
              "signals": ["iw.field3", "opr.loadb"]
            },
            {
              "signals": ["opr.outputa", "pc.load"]
            },
            {
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "signals": ["pmem.output", "ir.load", "iw.load", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "BEQ",
          "description": "Branch if equal, Z set; otherwise go on in two ticks",
          "operands": 1,
          "operandTypes": ["address"],
          "fields": [3],
          "steps": [
            {
              "when": { "Z": true },
              "signals": ["iw.field3", "opr.loadb"]
            },
            {
              "when": { "Z": true },
              "signals": ["opr.outputa", "pc.load"]
            },
            {
              "when": { "Z": true },
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "when": { "Z": true },
              "signals": ["pmem.output", "ir.load", "iw.load", "pc.inc"]
            },
            {
              "when": { "Z": false },
              "signals": ["pc.output", "pmem.loadmar"]
            },
            {
              "when": { "Z": false },
              "signals": ["pmem.output", "ir.load", "iw.load", "pc.inc"]
            }
          ]
