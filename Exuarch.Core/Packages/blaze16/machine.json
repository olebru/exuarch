      "parameters": { "size": 96 },
      "contents": [
        "; The palette twice over, so a slot plus a phase of 0 to 31 always lands on a colour,",
        "; then 32 blacks for the set at every phase",
        "cycle:  .DATA 0x0000, 0x58A0, 0x6920, 0x81C0, 0x9A60, 0xAB00, 0xC3A0, 0xDC40",
        "        .DATA 0xECC0, 0xFD61, 0xFDC5, 0xFE09, 0xF66D, 0xF6D1, 0xF735, 0xF779",
