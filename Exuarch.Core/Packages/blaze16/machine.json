{
  "name": "BLAZE-16",
  "buses": [
    {
      "id": "ibus",
      "layout": { "x": 0, "y": 222 }
    },
    {
      "id": "dbus",
      "layout": { "x": 0, "y": 596 }
    }
  ],
  "devices": [
    {
      "id": "pc",
      "type": "register",
      "name": "PC",
      "bus": "ibus",
      "layout": { "x": 30, "y": 40 }
    },
    {
      "id": "pmem",
      "type": "ram",
      "name": "PROGRAM",
      "bus": "ibus",
      "parameters": { "size": 1024 },
      "layout": { "x": 240, "y": 40 }
    },
    {
      "id": "ir",
      "type": "instructionRegister",
      "name": "IR",
      "note": "Counts the microcode steps. The last tick of each instruction loads it with the next word from PROGRAM, so FETCH only runs after a reset. MITER reloads it from WORD to repeat itself.",
      "bus": "ibus",
      "layout": { "x": 450, "y": 40 }
    },
    {
      "id": "iw",
      "type": "instructionWord",
      "name": "WORD",
      "note": "Latches each instruction word from ibus. Its field buffers drive the register numbers and the 10 bit branch address onto dbus. MITER drives the whole word back onto ibus to run again without a memory read.",
      "bus": "ibus",
      "buses": { "fields": "dbus" },
      "layout": { "x": 30, "y": 278 }
    },
    {
      "id": "opr",
      "type": "dualPortRegister",
      "name": "BRIDGE",
      "note": "Connects the two buses. Branches copy the address field from dbus to ibus through it for the PC, and ADDI, SUBI, CMPI and MOVI copy their value cell from ibus to dbus. DBNZ holds its branch address here.",
      "buses": { "a": "ibus", "b": "dbus" },
      "layout": { "x": 240, "y": 278 }
    },
    {
      "id": "rf",
      "type": "registerFile",
      "name": "REGISTERS",
      "bus": "dbus",
      "parameters": { "count": 8 },
      "layout": { "x": 450, "y": 444 }
    },
    {
      "id": "x",
      "type": "register",
      "name": "X",
      "bus": "dbus",
      "layout": { "x": 30, "y": 652 }
    },
    {
      "id": "y",
      "type": "register",
      "name": "Y",
      "bus": "dbus",
      "layout": { "x": 660, "y": 444 }
    },
    {
      "id": "alu",
      "type": "alu",
      "name": "ALU",
      "bus": "dbus",
      "connections": { "a": "x", "b": "y", "status": "flags" },
      "layout": { "x": 240, "y": 652 }
    },
    {
      "id": "flags",
      "type": "statusRegister",
      "name": "FLAGS",
      "bus": "dbus",
      "layout": { "x": 870, "y": 444 }
    },
    {
      "id": "zx",
      "type": "register",
      "name": "ZX",
      "note": "ZX and ZY hold z, the value each MITER step iterates for the current point. MPOINT copies CX and CY into them, and every MITER step writes z*z + c back: x*x - y*y + cx here, 2xy + cy in ZY.",
      "bus": "dbus",
      "layout": { "x": 450, "y": 652 }
    },
    {
      "id": "zy",
      "type": "register",
      "name": "ZY",
      "bus": "dbus",
      "layout": { "x": 1080, "y": 444 }
    },
    {
      "id": "cx",
      "type": "register",
      "name": "CX",
      "note": "CX and CY hold c, the current point's position on the plane. MPUT, MPLOT and MSLOT add STEP to CX for the next point, and MROW moves CX back to the left edge and adds STEP to CY.",
      "bus": "dbus",
      "layout": { "x": 660, "y": 652 }
    },
    {
      "id": "cy",
      "type": "register",
      "name": "CY",
      "bus": "dbus",
      "layout": { "x": 1290, "y": 444 }
    },
    {
      "id": "dx",
      "type": "register",
      "name": "STEP",
      "bus": "dbus",
      "layout": { "x": 870, "y": 652 }
    },
    {
      "id": "n",
      "type": "register",
      "name": "N",
      "note": "Counts the steps a point has left. MPOINT loads it from STEPS, each MITER step decrements it, and an escape copies it to LEFT and clears it. MITER repeats while N is not 0.",
      "bus": "dbus",
      "layout": { "x": 1500, "y": 444 }
    },
    {
      "id": "k",
      "type": "register",
      "name": "LEFT",
      "note": "Holds a point's result: the steps N had left when z escaped, or 0 for a point in the set. MPUT, MPLOT and MSLOT drive it into the COLOURS or SLOTS ROM as the address.",
      "bus": "dbus",
      "layout": { "x": 1080, "y": 652 }
    },
    {
      "id": "maxn",
      "type": "register",
      "name": "STEPS",
      "bus": "dbus",
      "layout": { "x": 1710, "y": 444 }
    },
    {
      "id": "lim",
      "type": "register",
      "name": "LIMIT",
      "bus": "dbus",
      "layout": { "x": 1290, "y": 652 }
    },
    {
      "id": "t",
      "type": "register",
      "name": "T",
      "note": "Holds x*x - y*y during a MITER step while the ALU forms x*x + y*y for the limit test, then copies it back to X so CX can be added to it.",
      "bus": "dbus",
      "layout": { "x": 1920, "y": 444 }
    },
    {
      "id": "ph",
      "type": "register",
      "name": "PHASE",
      "bus": "dbus",
      "layout": { "x": 1500, "y": 652 }
    },
    {
      "id": "sx",
      "type": "mac",
      "name": "X SQUARED",
      "note": "One of three multipliers that run in the same ticks: X SQUARED forms x*x, Y SQUARED y*y and X TIMES Y x*y, so a whole MITER step needs no multiply loop.",
      "bus": "dbus",
      "parameters": { "shift": 12 },
      "layout": { "x": 2130, "y": 444 }
    },
    {
      "id": "sy",
      "type": "mac",
      "name": "Y SQUARED",
      "bus": "dbus",
      "parameters": { "shift": 12 },
      "layout": { "x": 1710, "y": 652 }
    },
    {
      "id": "xy",
      "type": "mac",
      "name": "X TIMES Y",
      "bus": "dbus",
      "parameters": { "shift": 12 },
      "layout": { "x": 2340, "y": 444 }
    },
    {
      "id": "colour",
      "type": "rom",
      "name": "COLOURS",
      "bus": "dbus",
      "parameters": { "size": 256 },
      "contents": [
        "; The colour for each count of steps left: 0 is the set itself, black,",
