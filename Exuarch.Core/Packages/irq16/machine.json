{
  "name": "IRQ-16",
  "buses": [
    {
      "id": "main",
      "layout": { "x": 0, "y": 240 }
    },
    {
      "id": "video",
      "layout": { "x": 0, "y": 644 }
    }
  ],
  "devices": [
    {
      "id": "pc",
      "type": "register",
      "name": "PC",
      "bus": "main",
      "layout": { "x": 30, "y": 40 }
    },
    {
      "id": "ir",
      "type": "instructionRegister",
      "name": "IR",
      "bus": "main",
      "layout": { "x": 1290, "y": 40 }
    },
    {
      "id": "mem",
      "type": "ram",
      "name": "MEMORY",
      "bus": "main",
      "parameters": { "size": 4096 },
      "layout": { "x": 30, "y": 296 }
    },
    {
      "id": "flags",
      "type": "statusRegister",
      "name": "FLAGS",
      "bus": "main",
      "layout": { "x": 870, "y": 40 }
    },
    {
      "id": "sp",
      "type": "register",
      "name": "SP",
      "bus": "main",
      "layout": { "x": 240, "y": 296 }
    },
    {
      "id": "vec",
      "type": "register",
      "name": "VECTOR",
      "bus": "main",
      "layout": { "x": 240, "y": 40 }
    },
    {
      "id": "clk",
      "type": "clock",
      "name": "CLOCK",
      "layout": { "x": 1500, "y": 40 }
    },
    {
      "id": "a",
      "type": "register",
      "name": "A",
      "bus": "main",
      "layout": { "x": 1080, "y": 296 }
    },
    {
      "id": "b",
      "type": "register",
      "name": "B",
      "bus": "main",
      "layout": { "x": 450, "y": 296 }
    },
    {
      "id": "t",
      "type": "register",
      "name": "ALU OPERAND",
      "bus": "main",
      "layout": { "x": 450, "y": 40 }
    },
    {
      "id": "alu",
      "type": "alu",
      "name": "ALU",
      "bus": "main",
      "connections": { "a": "a", "b": "t", "status": "flags" },
      "layout": { "x": 870, "y": 296 }
    },
    {
      "id": "pic",
      "type": "interruptController",
      "name": "INTERRUPTS",
      "bus": "main",
      "connections": { "irq0": "tick", "irq1": "keys", "irq2": "blit", "irq3": "rtc" },
      "layout": { "x": 1080, "y": 40 }
    },
    {
      "id": "tick",
      "type": "timer",
      "name": "TIMER",
      "bus": "main",
      "parameters": { "period": 20000 },
      "layout": { "x": 1290, "y": 296 }
    },
    {
      "id": "rtc",
      "type": "rtc",
      "name": "REAL TIME CLOCK",
      "bus": "main",
      "parameters": { "interval": 1000 },
      "layout": { "x": 1710, "y": 296 }
    },
    {
      "id": "keys",
      "type": "keypad",
      "name": "KEYPAD",
      "bus": "main",
      "layout": { "x": 660, "y": 40 }
    },
    {
      "id": "lcd",
      "type": "display",
      "name": "LCD",
      "bus": "main",
      "parameters": { "columns": 32, "rows": 4 },
      "layout": { "x": 1500, "y": 296 }
    },
    {
      "id": "blit",
      "type": "blitter",
      "name": "BLITTER",
      "buses": { "host": "main", "video": "video" },
      "connections": { "screen": "fb" },
      "layout": { "x": 660, "y": 296 }
    },
    {
      "id": "fb",
      "type": "framebuffer",
      "name": "SCREEN",
      "bus": "video",
      "layout": { "x": 30, "y": 492 }
    }
  ],
  "decoder": {
    "status": "flags",
    "instructionRegister": "ir",
    "interrupts": "pic",
    "microcode": {
      "name": "IRQ-16 microcode",
      "fetch": {
        "mnemonic": "FETCH",
        "description": "I=0: load the opcode at the address in PC into IR and step PC past it. I=1 (interrupts enabled and an unmasked bit pending): push PC, then FLAGS, disable interrupts and set PC = VECTOR; the pending bit stays set until ACK",
        "steps": [
          {
            "when": { "I": false },
            "signals": ["pc.output", "mem.loadmar"]
          },
          {
            "when": { "I": false },
            "signals": ["mem.output", "ir.load", "pc.inc"]
          },
          {
            "when": { "I": true },
            "signals": ["sp.dec"]
          },
          {
            "when": { "I": true },
            "signals": ["sp.output", "mem.loadmar"]
          },
          {
            "when": { "I": true },
            "signals": ["pc.output", "mem.load", "sp.dec"]
          },
          {
            "when": { "I": true },
            "signals": ["sp.output", "mem.loadmar"]
          },
          {
            "when": { "I": true },
            "signals": ["flags.output", "mem.load"]
          },
          {
            "when": { "I": true },
            "signals": ["vec.output", "pc.load", "pic.disable", "ir.reset"]
          }
        ]
      },
      "instructions": [
        {
          "mnemonic": "NOP",
          "description": "Does nothing; registers and flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "HLT",
          "description": "Stops the clock, halting the machine",
          "operands": 0,
          "steps": [
            {
              "signals": ["clk.disable"]
            }
          ]
        },
        {
          "mnemonic": "LDI",
          "description": "A = the value after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "a.load"]
            }
          ]
        },
        {
          "mnemonic": "LBI",
          "description": "B = the value after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "b.load"]
            }
          ]
        },
        {
          "mnemonic": "LBA",
          "description": "B = the address after the opcode, as a pointer for LDX and STX; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "b.load"]
            }
          ]
        },
        {
          "mnemonic": "LDA",
          "description": "A = the cell at the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mem.loadmar", "pc.inc"]
            },
            {
              "signals": ["mem.output", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "STA",
          "description": "Stores A in the cell at the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mem.loadmar", "pc.inc"]
            },
            {
              "signals": ["a.output", "mem.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "LDX",
          "description": "A = the cell at the address in B; B and flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "STX",
          "description": "Stores A in the cell at the address in B; B and flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "mem.loadmar"]
            },
            {
              "signals": ["a.output", "mem.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "TAB",
          "description": "B = A; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.output", "b.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "TBA",
          "description": "A = B; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "INA",
          "description": "A = A \u002B 1, wrapping from FFFF to 0; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "INB",
          "description": "B = B \u002B 1, wrapping from FFFF to 0; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "DEB",
          "description": "B = B - 1, wrapping from 0 to FFFF; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.dec", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "ADD",
          "description": "A = A \u002B B; sets Z, N, C on carry out and V on signed overflow; ALU OPERAND is overwritten with B",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load"]
            },
            {
              "signals": ["alu.add", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "SUB",
          "description": "A = A - B; sets Z, N, C if A \u003C B unsigned (a borrow) and V on signed overflow; ALU OPERAND is overwritten with B",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load"]
            },
            {
              "signals": ["alu.sub", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "AND",
          "description": "A = A AND B; sets Z and N, clears C and V; ALU OPERAND is overwritten with B",
          "operands": 0,
          "steps": [
            {
              "signals": ["b.output", "t.load"]
            },
            {
              "signals": ["alu.and", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "ADDI",
          "description": "A = A \u002B the value after the opcode; sets Z, N, C on carry out and V on signed overflow; ALU OPERAND is overwritten",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.add", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "SUBI",
          "description": "A = A - the value after the opcode; sets Z, N, C if A \u003C value unsigned (a borrow) and V on signed overflow; ALU OPERAND is overwritten",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.sub", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "ANDI",
          "description": "A = A AND the value after the opcode; sets Z and N, clears C and V; ALU OPERAND is overwritten",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.and", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "EORI",
          "description": "A = A XOR the value after the opcode; sets Z and N, clears C and V; ALU OPERAND is overwritten",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.eor", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "LSRI",
          "description": "A = A shifted right, zero-filled, by the low 4 bits of the value after the opcode; sets Z and N, C to the last bit shifted out (clear for a shift of 0), clears V; ALU OPERAND is overwritten",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.lsr", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "CMPI",
          "description": "Sets the flags for A - the value after the opcode without changing A: Z if equal, C if A \u003C value unsigned, N and V as for SUBI; ALU OPERAND is overwritten",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "t.load", "pc.inc"]
            },
            {
              "signals": ["alu.cmp", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JMP",
          "description": "PC = the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JEQ",
          "description": "Jumps to the address after the opcode if Z is set (equal after CMPI); otherwise continues with the next instruction",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "Z": true },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "Z": true },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "Z": false },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JNE",
          "description": "Jumps to the address after the opcode if Z is clear (not equal after CMPI); otherwise continues with the next instruction",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "Z": false },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "Z": false },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "Z": true },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JCS",
          "description": "Jumps to the address after the opcode if C is set (A \u003C value unsigned after CMPI, or a carry out of ADD); otherwise continues with the next instruction",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "C": true },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "C": true },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "C": false },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "JCC",
          "description": "Jumps to the address after the opcode if C is clear (A \u003E= value unsigned after CMPI); otherwise continues with the next instruction",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "when": { "C": false },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "C": false },
              "signals": ["mem.output", "pc.load", "ir.reset"]
            },
            {
              "when": { "C": true },
              "signals": ["pc.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "CALL",
          "description": "Pushes the return address (the instruction after CALL) and jumps to the address after the opcode; the stack grows down, SP is decremented before the write and points at the last item pushed; ALU OPERAND is overwritten; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar", "pc.inc"]
            },
            {
              "signals": ["mem.output", "t.load", "sp.dec"]
            },
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["pc.output", "mem.load"]
            },
            {
              "signals": ["t.output", "pc.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "RET",
          "description": "PC = the cell at SP (the return address CALL pushed), then SP is incremented; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.load", "sp.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "PSA",
          "description": "Decrements SP, then stores A in the cell at SP (the stack grows down); flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["sp.dec"]
            },
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["a.output", "mem.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "POA",
          "description": "A = the cell at SP, then SP is incremented; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "a.load", "sp.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "PSB",
          "description": "Decrements SP, then stores B in the cell at SP (the stack grows down); flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["sp.dec"]
            },
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["b.output", "mem.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "POB",
          "description": "B = the cell at SP, then SP is incremented; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "b.load", "sp.inc", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "SETV",
          "description": "VECTOR = the address after the opcode: where FETCH jumps when it takes an interrupt; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "vec.load"]
            }
          ]
        },
        {
          "mnemonic": "EI",
          "description": "Enables interrupts: the next fetch takes one if an unmasked bit is pending",
          "operands": 0,
          "steps": [
            {
              "signals": ["pic.enable", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "DI",
          "description": "Disables interrupts; pending bits are kept and are taken after EI or RTI",
          "operands": 0,
          "steps": [
            {
              "signals": ["pic.disable", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "MASKI",
          "description": "Interrupt mask = the low 4 bits of the value after the opcode (bit 0 timer, bit 1 keypad, bit 2 blitter, bit 3 real time clock); only unmasked pending bits interrupt, and all are unmasked at reset",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "pic.loadmask"]
            }
          ]
        },
        {
          "mnemonic": "CAUSE",
          "description": "A = the pending interrupt bits that are unmasked (1 timer, 2 keypad, 4 blitter, 8 real time clock); they stay pending until ACK; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["pic.output", "a.load", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "ACK",
          "description": "Clears the pending interrupt bits that are set in A (1 timer, 2 keypad, 4 blitter, 8 real time clock); A and flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["a.output", "pic.ack", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "RTI",
          "description": "Pops FLAGS, then PC (the reverse of interrupt entry), incrementing SP after each, and enables interrupts; a pending bit not cleared by ACK interrupts again at the next fetch",
          "operands": 0,
          "steps": [
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "flags.load", "sp.inc"]
            },
            {
              "signals": ["sp.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.load", "sp.inc", "pic.enable", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "TPERI",
          "description": "Sets the timer\u0027s period to the value after the opcode, in clock ticks; a running timer raises irq0 every period ticks, and a period of 0 never fires",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "pc.inc", "ir.reset", "tick.loadperiod"]
            }
          ]
        },
        {
          "mnemonic": "TGO",
          "description": "Starts the timer from a count of 0; it raises irq0 every period ticks until TSTOP",
          "operands": 0,
          "steps": [
            {
              "signals": ["tick.start", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "TSTOP",
          "description": "Stops the timer; TGO restarts it from a count of 0",
          "operands": 0,
          "steps": [
            {
              "signals": ["tick.stop", "ir.reset"]
            }
          ]
        },
        {
          "mnemonic": "OUT",
          "description": "Writes the low 8 bits of A to the LCD at its cursor and moves the cursor on; 10 (line feed) and 13 (carriage return) move the cursor instead, and the LCD scrolls up when full",
          "operands": 0,
