{
  "name": "BYOC-16",
  "buses": [
    {
      "id": "main",
      "layout": { "x": 0, "y": 222 }
    }
  ],
  "devices": [
    {
      "id": "regi",
      "type": "instructionRegister",
      "name": "REGINSTR",
      "bus": "main",
      "layout": { "x": 1290, "y": 40 }
    },
    {
      "id": "pc",
      "type": "register",
      "name": "PCOUNT",
      "bus": "main",
      "layout": { "x": 30, "y": 278 }
    },
    {
      "id": "regsp",
      "type": "register",
      "name": "REGSP",
      "bus": "main",
      "layout": { "x": 30, "y": 40 }
    },
    {
      "id": "rega",
      "type": "register",
      "name": "REGA",
      "bus": "main",
      "layout": { "x": 240, "y": 278 }
    },
    {
      "id": "regb",
      "type": "register",
      "name": "REGB",
      "bus": "main",
      "layout": { "x": 240, "y": 40 }
    },
    {
      "id": "regc",
      "type": "register",
      "name": "REGC",
      "bus": "main",
      "layout": { "x": 450, "y": 278 }
    },
    {
      "id": "regs",
      "type": "register",
      "name": "REGSWAP",
      "bus": "main",
      "layout": { "x": 450, "y": 40 }
    },
    {
      "id": "alu",
      "type": "alu",
      "name": "ALU",
      "bus": "main",
      "connections": { "a": "rega", "b": "regb", "status": "regsta" },
      "layout": { "x": 660, "y": 278 }
    },
    {
      "id": "regsta",
      "type": "statusRegister",
      "name": "STATUS",
      "bus": "main",
      "layout": { "x": 870, "y": 40 }
    },
    {
      "id": "mem",
      "type": "ram",
      "name": "BASEMEM",
      "bus": "main",
      "parameters": { "size": 4096 },
      "layout": { "x": 870, "y": 278 }
    },
    {
      "id": "mmu",
      "type": "mmu",
      "name": "MMU",
      "bus": "main",
      "parameters": { "banks": 16, "bankSize": 4096 },
      "layout": { "x": 660, "y": 40 }
    },
    {
      "id": "clk",
      "type": "clock",
      "name": "Clock",
      "layout": { "x": 1500, "y": 40 }
    },
    {
      "id": "lcd",
      "type": "display",
      "name": "LCD",
      "bus": "main",
      "parameters": { "columns": 32, "rows": 4 },
      "layout": { "x": 1080, "y": 278 }
    },
    {
      "id": "fb",
      "type": "framebuffer",
      "name": "SCREEN",
      "bus": "main",
      "layout": { "x": 1290, "y": 278 }
    },
    {
      "id": "keys",
      "type": "keypad",
      "name": "KEYPAD",
      "bus": "main",
      "layout": { "x": 1080, "y": 40 }
    }
  ],
  "decoder": {
    "status": "regsta",
    "instructionRegister": "regi",
    "microcode": {
      "name": "BYOC-16 microcode",
      "fetch": {
        "mnemonic": "FTC",
        "description": "Fetch: load the opcode at PC in base memory into the instruction register, which starts that instruction\u0027s micro steps; PC is not stepped here, each instruction steps it itself",
        "steps": [
          {
            "signals": ["pc.output", "mem.loadmar"]
          },
          {
            "signals": ["mem.output", "regi.load"]
          }
        ]
      },
      "instructions": [
        {
          "mnemonic": "TAB",
          "description": "B = A; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["rega.output", "regb.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "TBA",
          "description": "A = B; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["regb.output", "rega.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "ADD",
          "description": "A = A \u002B B. Sets Z, N, C (carry out) and V (signed overflow)",
          "operands": 0,
          "steps": [
            {
              "signals": ["alu.add", "rega.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "SUB",
          "description": "A = A - B. Sets Z, N, C (borrow: A \u003C B unsigned) and V (signed overflow)",
          "operands": 0,
          "steps": [
            {
              "signals": ["alu.sub", "rega.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "STA",
          "description": "Store A in the selected MMU bank (not base memory) at the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mmu.loadmar"]
            },
            {
              "signals": ["rega.output", "mmu.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "STB",
          "description": "Store B in the selected MMU bank (not base memory) at the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mmu.loadmar"]
            },
            {
              "signals": ["regb.output", "mmu.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LRA",
          "description": "Load A from the base memory cell at the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mem.loadmar"]
            },
            {
              "signals": ["rega.load", "mem.output", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LRB",
          "description": "Load B from the base memory cell at the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mem.loadmar"]
            },
            {
              "signals": ["regb.load", "mem.output", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LDA",
          "description": "Load A from the cell in the selected MMU bank at the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mmu.loadmar"]
            },
            {
              "signals": ["rega.load", "mmu.output", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LDB",
          "description": "Load B from the cell in the selected MMU bank at the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mmu.loadmar"]
            },
            {
              "signals": ["regb.load", "mmu.output", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "PSA",
          "description": "Push A: SP is decremented, then A is stored at SP in MMU bank 0 (full descending stack); the selected bank is kept; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["regsp.dec"]
            },
            {
              "signals": ["regs.load", "mmu.outputcs"]
            },
            {
              "signals": ["mmu.select0stack", "mmu.loadmar", "regsp.output"]
            },
            {
              "signals": ["rega.output", "mmu.load"]
            },
            {
              "signals": ["regs.output", "mmu.loadcs"]
            },
            {
              "signals": ["regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "POA",
          "description": "Pop A: A is loaded from SP in MMU bank 0, then SP is incremented; the selected bank is kept; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["regs.load", "mmu.outputcs"]
            },
            {
              "signals": ["mmu.select0stack"]
            },
            {
              "signals": ["mmu.loadmar", "regsp.output"]
            },
            {
              "signals": ["rega.load", "mmu.output", "regsp.inc"]
            },
            {
              "signals": ["regs.output", "mmu.loadcs", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "PSB",
          "description": "Push B: SP is decremented, then B is stored at SP in MMU bank 0 (full descending stack); the selected bank is kept; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["regsp.dec"]
            },
            {
              "signals": ["regs.load", "mmu.outputcs"]
            },
            {
              "signals": ["mmu.select0stack", "mmu.loadmar", "regsp.output"]
            },
            {
              "signals": ["regb.output", "mmu.load"]
            },
            {
              "signals": ["regs.output", "mmu.loadcs"]
            },
            {
              "signals": ["regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "POB",
          "description": "Pop B: B is loaded from SP in MMU bank 0, then SP is incremented; the selected bank is kept; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["regs.load", "mmu.outputcs"]
            },
            {
              "signals": ["mmu.select0stack"]
            },
            {
              "signals": ["mmu.loadmar", "regsp.output"]
            },
            {
              "signals": ["regb.load", "mmu.output", "regsp.inc"]
            },
            {
              "signals": ["regs.output", "mmu.loadcs", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "NOP",
          "description": "Do nothing and go on with the next instruction; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LNA",
          "description": "Load A from the base memory cell at the address after the opcode \u002B B. Sets Z, N, C and V from that address sum, not from the loaded value",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "rega.load"]
            },
            {
              "signals": ["alu.add", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "rega.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "CMP",
          "description": "Sets the flags for A - B without changing A: Z if equal, C if A \u003C B unsigned, N and V as for SUB",
          "operands": 0,
          "steps": [
            {
              "signals": ["alu.cmp", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "JMP",
          "description": "Jump to the address after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["pc.load", "mem.output", "regi.reset"]
            }
          ]
        },
        {
          "mnemonic": "JEQ",
          "description": "Jump to the address after the opcode if Z is set (equal after CMP); otherwise go on with the next instruction. Flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "when": { "Z": true },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "Z": true },
              "signals": ["pc.load", "mem.output", "regi.reset"]
            },
            {
              "when": { "Z": false },
              "signals": ["regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "JNE",
          "description": "Jump to the address after the opcode if Z is clear (not equal after CMP); otherwise go on with the next instruction. Flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "when": { "Z": false },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "Z": false },
              "signals": ["pc.load", "mem.output", "regi.reset"]
            },
            {
              "when": { "Z": true },
              "signals": ["regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "RST",
          "description": "Clear all the status flags (Z, N, C and V)",
          "operands": 0,
          "steps": [
            {
              "signals": ["regsta.reset", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "JC",
          "description": "Jump to the address after the opcode if C is set (A \u003C B unsigned after CMP, or a carry after ADD); otherwise go on with the next instruction. Flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "when": { "C": true },
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "when": { "C": true },
              "signals": ["pc.load", "mem.output", "regi.reset"]
            },
            {
              "when": { "C": false },
              "signals": ["regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LPA",
          "description": "Load A through a pointer: read the base memory cell at the address after the opcode, then load A from the base memory cell that value points at; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mem.loadmar"]
            },
            {
              "signals": ["rega.load", "mem.output", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LPB",
          "description": "Load B through a pointer: read the base memory cell at the address after the opcode, then load B from the base memory cell that value points at; flags unchanged",
          "operands": 1,
          "operandTypes": ["address"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mem.loadmar"]
            },
            {
              "signals": ["regb.load", "mem.output", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "HLT",
          "description": "Stop the clock, halting the machine; PC stays on the HLT. Flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["clk.disable"]
            }
          ]
        },
        {
          "mnemonic": "LAI",
          "description": "Load A with the value after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "rega.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "LBI",
          "description": "Load B with the value after the opcode; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "regb.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "PEA",
          "description": "Peek: load A from SP in MMU bank 0 (the top of the stack) without moving SP; the selected bank is kept; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["regs.load", "mmu.outputcs"]
            },
            {
              "signals": ["mmu.select0stack"]
            },
            {
              "signals": ["mmu.loadmar", "regsp.output"]
            },
            {
              "signals": ["rega.load", "mmu.output"]
            },
            {
              "signals": ["regs.output", "mmu.loadcs", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "PEB",
          "description": "Peek: load B from SP in MMU bank 0 (the top of the stack) without moving SP; the selected bank is kept; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["regs.load", "mmu.outputcs"]
            },
            {
              "signals": ["mmu.select0stack"]
            },
            {
              "signals": ["mmu.loadmar", "regsp.output"]
            },
            {
              "signals": ["regb.load", "mmu.output"]
            },
            {
              "signals": ["regs.output", "mmu.loadcs", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "SWB",
          "description": "Select the MMU bank given by the value after the opcode (taken modulo 16) for LDA, LDB, STA and STB; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "mmu.loadcs", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "INA",
          "description": "A = A \u002B 1, wrapping from FFFF to 0; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["rega.inc", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "INB",
          "description": "B = B \u002B 1, wrapping from FFFF to 0; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["regb.inc", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "DCL",
          "description": "Blank the LCD and move its cursor to the first cell; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["lcd.clear", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "DWA",
          "description": "Print the low 8 bits of A as a Latin-1 character at the LCD cursor and move the cursor on (0A new line, 0D start of row); flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["rega.output", "lcd.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "DWB",
          "description": "Print the low 8 bits of B as a Latin-1 character at the LCD cursor and move the cursor on (0A new line, 0D start of row); flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["regb.output", "lcd.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "DWI",
          "description": "Print the low 8 bits of the value after the opcode as a Latin-1 character at the LCD cursor and move the cursor on; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "lcd.load", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "GCL",
          "description": "Clear the screen to black and move its cursor to 0, 0; flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["fb.clear", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "GXI",
          "description": "Move the screen cursor to the column given by the value after the opcode (modulo 640); flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "fb.loadx", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "GYI",
          "description": "Move the screen cursor to the row given by the value after the opcode (modulo 480); flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "fb.loady", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "GXA",
          "description": "Move the screen cursor to the column in A (modulo 640); flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["rega.output", "fb.loadx", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "GYA",
          "description": "Move the screen cursor to the row in A (modulo 480); flags unchanged",
          "operands": 0,
          "steps": [
            {
              "signals": ["rega.output", "fb.loady", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "GPI",
          "description": "Plot the RGB565 colour after the opcode at the screen cursor and move the cursor right, wrapping to the next row; flags unchanged",
          "operands": 1,
          "operandTypes": ["value"],
          "steps": [
            {
              "signals": ["pc.inc"]
            },
            {
              "signals": ["pc.output", "mem.loadmar"]
            },
            {
              "signals": ["mem.output", "fb.plot", "regi.reset", "pc.inc"]
            }
          ]
        },
        {
          "mnemonic": "GPA",
          "description": "Plot the RGB565 colour in A at the screen cursor and move the cursor right, wrapping to the next row; flags unchanged",
          "operands": 0,
