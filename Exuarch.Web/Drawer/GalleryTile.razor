<button class="tile @(Selected ? "selected" : "") @(Current ? "current" : "")" aria-pressed="@(Selected ? "true" : "false")" @onclick="OnClick">
    <GalleryPicture Name="@Name" Preview="Preview" />
    <span class="tile-text">
        <span class="tile-name">@Name</span>
        @if (Current) { <span class="tile-badge open silk">open</span> }
        @if (Badge != null) { <span class="tile-badge silk">@Badge</span> }
        <span class="tile-tagline">@Summary</span>
    </span>
</button>

@code
{
    [Parameter] public string Name { get; set; }
    [Parameter] public string Summary { get; set; }
    [Parameter] public GalleryPreview Preview { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Current { get; set; }
    [Parameter] public string Badge { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
