<div class="machine-detail">
    <p class="machine-description">@Package.Description</p>
    @if (Package.Programs.Count > 0)
    {
        <div class="machine-programs">
            <span class="silk">@Words.Count(Package.Programs.Count, "program")</span>
            @string.Join(" · ", Package.Programs.Select(p => p.Name))
        </div>
    }
    <div class="machine-actions">
        @if (Current)
        {
            <button class="btn btn-sm btn-primary" title="Read its note in This machine" @onclick="Actions.Read">Read the note</button>
        }
        else
        {
            <button class="btn btn-sm btn-primary" @onclick="() => Actions.Load.InvokeAsync(Package.Name)">Load</button>
        }
        <button class="btn btn-sm btn-outline-secondary" title="@ExportTitle" @onclick="() => Actions.Export.InvokeAsync(Package.Name)">Export</button>
        <span class="grow"></span>
        @if (Own)
        {
            <button class="btn btn-sm btn-outline-danger" title="Remove it from this browser" @onclick="() => Actions.Delete.InvokeAsync(Package.Name)">Delete</button>
        }
        else if (Edited)
        {
            <button class="btn btn-sm btn-outline-danger" title="Throw away your changes and bring it back the way it ships" @onclick="() => Actions.Reset.InvokeAsync(Package.Name)">Reset</button>
        }
    </div>
</div>

@code
{
    [Parameter] public MachinePackage Package { get; set; }
    [Parameter] public bool Current { get; set; }
    [Parameter] public bool Own { get; set; }
    [Parameter] public bool Edited { get; set; }
    [Parameter] public PackageActions Actions { get; set; }

    private string ExportTitle => Own ? "Save it as a file" : "Save it as a file, with your changes if it has any";
}
