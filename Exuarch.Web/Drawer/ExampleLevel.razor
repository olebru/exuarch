@{
    var examples = BuiltInPackages.All.Where(p => BuiltInPackages.Level(p.Name) == Level).ToList();
    var open = Folds.IsOpen(Level);
}
<button class="level-toggle @(open ? "" : "collapsed")" title="@Hint" @onclick="() => Folds.Toggle(Level)">
    <i class="chev"></i>@Title <span class="level-count">@examples.Count</span>
</button>
@if (open)
{
    @foreach (var example in examples)
    {
        <PackageCard Package="example" Current="@Current" Actions="Actions" Edited="@(Workspace?.IsEdited(example.Name) == true)" />
    }
}

@code
{
    // The examples of one level, under a heading that folds them away.
    [Parameter] public string Level { get; set; }
    [Parameter] public ExampleFolds Folds { get; set; }
    // Which examples the user has changed, and the name of the machine that is open.
    [Parameter] public Workspace Workspace { get; set; }
    [Parameter] public string Current { get; set; }
    [Parameter] public PackageActions Actions { get; set; }

    private string Title => char.ToUpperInvariant(Level[0]) + Level.Substring(1);

    private string Hint => Level switch
    {
        "simple" => "One bus and a handful of registers: start here",
        "advanced" => "Register files, several buses, transport triggering, coprocessors and interrupts",
        BuiltInPackages.TutorialLevel => "The machine each tutorial starts from, for when you skipped one or lost your own",
        _ => "Graphics pipelines, and one machine tuned until it is hard to read",
    };
}
