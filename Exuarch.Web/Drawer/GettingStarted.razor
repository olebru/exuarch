@using Exuarch.Core
@inject IJSRuntime JS

<aside class="drawer @(Wide ? "wide" : "")" aria-label="Getting started">
    <div class="drawer-head">
        <span class="drawer-title">Getting started</span>
        <span class="grow"></span>
        <button class="drawer-close" title="Close" @onclick="OnClose">×</button>
    </div>
    <div class="drawer-sections">
        @foreach (var section in Sections)
        {
            <button class="drawer-section @(Section == section ? "on" : "")" @onclick="() => Show(section)">@section</button>
        }
    </div>
    <div class="drawer-body" @ref="body">
        @if (Section == "Handbook")
        {
            <HandbookSection Page="Page" Package="Package" Query="@query" QueryChanged="SetQuery" OnOpen="Open" OnLink="OnLink" />
        }
        else if (Section == "Machines")
        {
            <MachinesSection Workspace="Workspace" Current="@Package.Name" OpenPackage="Package" Browser="browser" Actions="actions" OnStartOver="OnStartOver" OnOpenGallery="OnOpenGallery" OnOpenGuide="OpenGuide" />
        }
        else
        {
            <ThisMachineSection Package="Package" IsBuiltIn="IsBuiltIn" View="@machineView" OnView="ShowMachine" Editing="editing" OnToggleEditing="ToggleEditing"
                                OnReadmeEdited="SetReadme" DefinitionJson="@DefinitionJson" JsonErrors="JsonErrors" OnJsonChanged="OnJsonChanged" OnLink="OnLink" />
        }
    </div>
</aside>

@code
{
    public static readonly string[] Sections = { "Handbook", "Machines", "This machine" };

    [Parameter] public MachinePackage Package { get; set; }
    [Parameter] public bool IsBuiltIn { get; set; }
    [Parameter] public string Section { get; set; } = "Handbook";
    [Parameter] public EventCallback<string> SectionChanged { get; set; }
    [Parameter] public (string Kind, string Target)? Page { get; set; }
    [Parameter] public EventCallback<(string Kind, string Target)?> PageChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnLoadPackage { get; set; }
    [Parameter] public EventCallback<CommunityMachine> OnLoadCommunity { get; set; }
    [Parameter] public EventCallback OnOpenGallery { get; set; }
    [Parameter] public Workspace Workspace { get; set; }
    [Parameter] public EventCallback<string> OnResetPackage { get; set; }
    [Parameter] public EventCallback<string> OnDeletePackage { get; set; }
    [Parameter] public EventCallback<string> OnExportPackage { get; set; }
    [Parameter] public EventCallback OnStartOver { get; set; }
    [Parameter] public EventCallback OnReadmeChanged { get; set; }
    [Parameter] public string DefinitionJson { get; set; }
    [Parameter] public IReadOnlyList<string> JsonErrors { get; set; }
    [Parameter] public EventCallback<string> OnJsonChanged { get; set; }
    [Parameter] public EventCallback<(string Kind, string Target)> OnLink { get; set; }

    private ElementReference body;
    private (string Kind, string Target)? shownPage;
    private string shownSection;
    private readonly MachineBrowser browser = new MachineBrowser();
    private PackageActions actions;
    private string query;
    private string machineView = "Note";
    private bool editing;

    private bool Wide => editing || (Section == "This machine" && machineView == "JSON");

    protected override void OnParametersSet()
    {
        if (IsBuiltIn || Section != "This machine") editing = false;
        actions = new PackageActions(EventCallback.Factory.Create(this, () => Show("This machine")), OnLoadPackage, OnExportPackage, OnDeletePackage, OnResetPackage, OnLoadCommunity);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shownPage != Page || shownSection != Section)
        {
            shownPage = Page;
            shownSection = Section;
            if (!firstRender) await JS.InvokeVoidAsync("exuarchReadme.scrollTop", body);
        }
    }

    private void SetQuery(string text)
    {
        query = text;
    }

    private void ShowMachine(string view)
    {
        machineView = view;
        editing = false;
    }

    private void ToggleEditing()
    {
        editing = !editing;
    }

    private async Task Show(string section)
    {
        editing = false;
        Section = section;
        await SectionChanged.InvokeAsync(section);
    }

    private async Task Open((string Kind, string Target)? page)
    {
        Page = page;
        await PageChanged.InvokeAsync(page);
    }

    private async Task OpenGuide(string id)
    {
        await Show("Handbook");
        await Open(("guide", id));
    }

    private Task SetReadme(string markdown)
    {
        Package.Readme = markdown;
        return OnReadmeChanged.InvokeAsync();
    }
}
