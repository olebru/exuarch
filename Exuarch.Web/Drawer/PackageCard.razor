@{ var current = Package.Name == Current; }
<div class="example @(current ? "current" : "")">
    <div class="example-head">
        <span class="example-name">@Package.Name</span>
        @if (Edited) { <span class="example-edited silk" title="You have changed it; the changes are kept in this browser">edited</span> }
        <span class="grow"></span>
        @if (current)
        {
            <span class="example-open silk">open</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="Actions.Read">Read</button>
        }
        else
        {
            <button class="btn btn-sm btn-outline-primary" @onclick="() => Actions.Load.InvokeAsync(Package.Name)">Load</button>
        }
        <button class="btn btn-sm btn-outline-secondary" title="@ExportTitle" @onclick="() => Actions.Export.InvokeAsync(Package.Name)">Export</button>
        @if (Own)
        {
            <button class="btn btn-sm btn-outline-danger" title="Remove it from this browser" @onclick="() => Actions.Delete.InvokeAsync(Package.Name)">Delete</button>
        }
        else if (Edited)
        {
            <button class="btn btn-sm btn-outline-danger" title="Throw away your changes and bring it back the way it ships" @onclick="() => Actions.Reset.InvokeAsync(Package.Name)">Reset</button>
        }
    </div>
    <div class="example-description">@Package.Description</div>
</div>

@code
{
    // A machine in the list: open it, read it if it is open, export it, and delete it if it is the user's own or reset
    // it if it is an example they changed.
    [Parameter] public MachinePackage Package { get; set; }
    // The name of the machine that is open.
    [Parameter] public string Current { get; set; }
    [Parameter] public PackageActions Actions { get; set; }
    // The user's own machine, as opposed to an example.
    [Parameter] public bool Own { get; set; }
    [Parameter] public bool Edited { get; set; }

    private string ExportTitle => Own ? "Save it as a file" : "Save it as a file, with your changes if it has any";
}
