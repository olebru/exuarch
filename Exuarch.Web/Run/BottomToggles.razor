@* The toggles at the start of the first group below: fold the panels below away, and split them in two. *@
<button class="panel-toggle bottom-toggle" title="@(Folded ? "Show the panels below" : "Hide the panels below")" @onclick="@(() => Actions.Toggle.InvokeAsync(Dock.Bottom.Key()))"><i class="chev"></i></button>
<button class="bottom-split-toggle @(Split ? "on" : "")" title="@(Split ? "Put the panels below back in one group" : "Split the panels below into two groups side by side")" @onclick="Actions.ToggleSplit">◫</button>

@code
{
    [Parameter] public RunLayout Layout { get; set; }
    [Parameter] public PanelActions Actions { get; set; }

    private bool Folded => Layout.Collapsed(Dock.Bottom.Key());
    private bool Split => Layout.Saved.BottomSplit;
}
