<div class="controls">
    <button class="ctl primary" title="Run / pause (Space)" disabled="@(!Session.CanRun)" @onclick="OnRun">
        @(Session.Running ? "❚❚ Pause" : "▶ Run")
    </button>
    <button class="ctl" title="One clock tick (→)" disabled="@(!Session.CanStep)" @onclick="OnTick">Tick</button>
    <button class="ctl" title="Run the current instruction and fetch the next (Shift+→)" disabled="@(!Session.CanStep)" @onclick="OnInstruction">Instruction</button>
    <button class="ctl" title="Reload the program and reset every device (R)" @onclick="OnRestart">⟲ Reset</button>
    <span class="sep"></span>
    <label class="speed @(Speed.Max ? "off" : "")" title="Clock speed while running">
        <input type="range" min="0" max="@RunSpeed.SliderSteps" disabled="@Speed.Max" @bind="Speed.Slider" @bind:event="oninput" @bind:after="Session.NotifyChanged" />
        <span>@(Speed.Max ? "max" : ShortHz(Speed.Hz))</span>
    </label>
    <button class="ctl @(Speed.Max ? "on" : "")" title="Run as fast as the browser allows, ignoring the slider (M). For the speed, some things are left out: the view is redrawn only every so often, and the trace stops. A double buffered screen still shows every frame it finishes" @onclick="OnToggleMax">⚡ Max</button>
    <span class="sep"></span>
    <MenuButton TriggerClass="ctl" Title="Show or fold away the side columns, or put every panel back where it started">
        <Trigger>Layout ▾</Trigger>
        <ChildContent>
            @foreach (var (column, label) in Columns)
            {
                var shown = !Layout.Collapsed(column);
                <button class="menu-item" role="menuitemcheckbox" aria-checked="@(shown ? "true" : "false")" @onclick="@(() => OnToggleColumn.InvokeAsync(column))"><span class="menu-check">@(shown ? "✓" : "")</span>@label</button>
            }
            <div class="menu-sep"></div>
            <button class="menu-item" role="menuitem" title="Put every panel back where it started, at its first size" @onclick="OnResetLayout"><span class="menu-check"></span>Default layout</button>
        </ChildContent>
    </MenuButton>
    <span class="grow"></span>
    @if (!string.IsNullOrEmpty(ProgramName))
    {
        <span class="loaded" title="@($"{MachineName} running {ProgramName}")">
            @if (!string.IsNullOrEmpty(MachineName)) { <span class="loaded-machine">@MachineName</span><span class="loaded-sep">/</span> }
            <span class="loaded-program">@ProgramName</span>
        </span>
    }
    <span class="cycle">cycle <strong>@Session.Machine.Cycles</strong></span>
    <span class="state state-@StateName">@StateName</span>
</div>

@code
{
    [Parameter] public RunSession Session { get; set; }
    [Parameter] public RunLayout Layout { get; set; }
    [Parameter] public string MachineName { get; set; }
    [Parameter] public string ProgramName { get; set; }

    [Parameter] public EventCallback OnRun { get; set; }
    [Parameter] public EventCallback OnTick { get; set; }
    [Parameter] public EventCallback OnInstruction { get; set; }
    [Parameter] public EventCallback OnRestart { get; set; }
    [Parameter] public EventCallback OnToggleMax { get; set; }
    [Parameter] public EventCallback<string> OnToggleColumn { get; set; }
    [Parameter] public EventCallback OnResetLayout { get; set; }

    private static readonly (string Column, string Label)[] Columns = { ("left", "Left column"), ("right", "Right column") };

    private RunSpeed Speed => Session.Speed;
    private string StateName => Session.State.ToString().ToLowerInvariant();
}
