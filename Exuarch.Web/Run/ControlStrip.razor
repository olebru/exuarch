@* The control word: every control line, lit when enabled this tick. Folded, only the lines that are on. *@
@{ var shown = Shown(); }
<div class="control-strip @(Folded ? "collapsed" : "")" title="Control lines driven by the decoder ROM this tick">
    <button class="strip-title panel-toggle" title="@(Folded ? "Show every control line" : "Show only the lines that are on")" @onclick="OnToggle"><i class="chev"></i>control lines</button>
    @foreach (var (group, lights) in shown)
    {
        <span class="line-group" style="--cat:@group.Color">
            <span class="line-device" title="@($"{group.Device.Type}: {group.Info.Description}")">@group.Device.Id</span>
            @foreach (var light in lights)
            {
                <span class="@light.Css" title="@light.Title">@light.Line</span>
            }
        </span>
    }
    @if (shown.Count == 0) { <span class="muted">none on this tick</span> }
</div>

@code
{
    [Parameter] public RunSession Session { get; set; }
    [Parameter] public bool Folded { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }

    // The groups with a line to show, and their lights.
    private List<(ControlLineGroup Group, List<LineLight> Lights)> Shown()
    {
        var last = Session.Last;
        return ControlLineGroup.Of(Session).Select(group => (group, group.Lights(last, Folded))).Where(shown => shown.Item2.Count > 0).ToList();
    }
}
