@page "/"

<div class="workspace @(drawerOpen ? "drawer-open" : "")">
@if (PackageError != null)
{
    <div class="alert alert-danger alert-dismissible">@PackageError <button type="button" class="btn-close" aria-label="Close" @onclick="() => PackageError = null"></button></div>
}
@if (StorageWarning != null)
{
    <div class="alert alert-warning alert-dismissible">@StorageWarning <button type="button" class="btn-close" aria-label="Close" @onclick="() => StorageWarning = null"></button></div>
}
@if (pendingConfirm is { } question)
{
    <div class="confirm-bar" role="alertdialog">
        <span class="confirm-message">@question.Message</span>
        <button class="btn btn-sm btn-danger" @onclick="Confirm">@question.Action</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => pendingConfirm = null">Cancel</button>
    </div>
}

<div class="workspace-header">
    <ul class="nav nav-tabs">
        @foreach (var (tab, index) in Tabs.Select((t, i) => (t, i)))
        {
            <li class="nav-item">
                <a class="nav-link @(ActiveTab == tab ? "active" : "")" href="" @onclick="() => ActiveTab = tab" @onclick:preventDefault>
                    <span class="tab-index">@((index + 1).ToString("00"))</span>@tab
                    @if (tab == "Hardware design" && DefinitionErrors.Count > 0) { <span class="badge badge-danger ms-1">@DefinitionErrors.Count</span> }
                    @if (tab == "Microcode" && MicrocodeErrorCount > 0) { <span class="badge badge-danger ms-1">@MicrocodeErrorCount</span> }
                    @if (tab == "Microcode" && MicrocodeErrorCount == 0 && MicrocodeWarningCount > 0) { <span class="badge badge-warning ms-1">@MicrocodeWarningCount</span> }
                    @if (tab == "Program" && ProgramErrors.Count > 0) { <span class="badge badge-danger ms-1">@ProgramErrors.Count</span> }
                </a>
            </li>
        }
    </ul>
    <div class="workspace-actions">
        <button class="btn btn-sm getting-started @(drawerOpen ? "on" : "")" @onclick="@(() => ToggleDrawer("Handbook"))" title="The handbook, the example machines and this machine's note">Getting started</button>
        <span class="package-label silk">Package</span>
        <button class="package-name" title="@Package.Description" @onclick="@(() => ToggleDrawer("Machines"))">@PackageName@(IsBuiltIn ? (IsEdited ? " · edited" : "") : " · yours")@if (ParseErrors.Count > 0) { <span class="badge badge-danger ms-1" title="The machine's JSON has errors: open This machine, JSON">@ParseErrors.Count</span> }</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="OpenNewDialog" title="Start a new machine of your own">New…</button>
        @if (IsBuiltIn)
        {
            <button class="btn btn-sm btn-outline-secondary" disabled="@(!IsEdited)" @onclick="() => ResetPackage(PackageName)"
                    title="@(IsEdited ? "Throw away your changes to this package and load it the way it ships" : "Nothing to reset: this package is the way it ships")">Reset</button>
        }
        <label class="btn btn-sm btn-outline-secondary mb-0" title="Import a package file: a machine with its microcode, programs and note">
            Import…<InputFile OnChange="ImportPackage" accept=".json" class="d-none" />
        </label>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ExportPackage" title="Export this package as a file: the machine, its microcode, the programs and the note">Export</button>
    </div>
</div>

@if (newDialog)
{
    <div class="new-backdrop" @onclick="() => newDialog = false">
        <div class="new-dialog" @onclick:stopPropagation @onkeydown="NewDialogKey">
            <div class="new-title">New machine</div>
            <label class="silk" for="new-name">Name</label>
            <input id="new-name" class="form-control form-control-sm" @bind="newName" @bind:event="oninput" @ref="newNameInput" />
            <div class="silk new-start-label">Start from</div>
            @foreach (var (value, title, description) in NewStarts)
            {
                <label class="new-start @(newStart == value ? "chosen" : "")">
                    <input type="radio" name="new-start" checked="@(newStart == value)" @onchange="() => newStart = value" />
                    <span><strong>@title</strong><small>@description</small></span>
                </label>
            }
            <div class="new-note">The new machine is kept in this browser. Export saves it as a package file, to keep or share, that Import… opens again.</div>
            <div class="new-actions">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => newDialog = false">Cancel</button>
                <button class="btn btn-sm btn-primary" @onclick="CreateMachine">Create</button>
            </div>
        </div>
    </div>
}

@if (ActiveTab == "Hardware design")
{
    <MachineEditor Definition="Definition" DefinitionChanged="OnDesignChanged" Errors="DefinitionErrors" Preview="C" Registry="Registry"
                   History="History" OnOpenMicrocode="OpenMicrocode" FocusDevice="@focusDevice" FocusVersion="focusVersion" />
}
else if (ActiveTab == "Microcode")
{
    @if (Definition.Decoder?.Microcode == null)
    {
        <div class="alert alert-warning">
            This machine has no microcode yet.
            <button class="btn btn-sm btn-primary ms-2" @onclick="StartMicrocode">Start with an empty fetch routine</button>
        </div>
    }
    else
    {
        <MicrocodeEditor Microcode="Definition.Decoder.Microcode" MicrocodeChanged="OnMicrocodeChanged" Machine="Definition" Diagnostics="MicrocodeDiagnostics" Registry="Registry"
                         History="History" OnOpenDevice="OpenDevice" FocusMnemonic="@focusMnemonic" FocusStep="focusStep" FocusVersion="focusVersion" />
    }
}
else if (ActiveTab == "Program")
{
    <div class="examples">
        <span class="examples-label silk">Programs · @PackageName<HelpLink Target="assembly" Title="Assembly: syntax, literals, .DATA and .STRING" /></span>
        @foreach (var example in Package.Programs)
        {
            <button class="btn btn-sm @(IsCurrent(example) ? "btn-primary" : "btn-outline-primary")" title="@example.Description" @onclick="() => PickProgram(example)">@example.Name</button>
        }
        @if (newProgramName == null)
        {
            <button class="btn btn-sm btn-outline-secondary" title="Start an empty program and add it to the package" @onclick="StartNewProgram">＋ New program</button>
        }
        else
        {
            <span class="new-program">
                <input class="form-control form-control-sm" placeholder="My program" aria-label="Name of the new program" @bind="newProgramName" @bind:event="oninput" @onkeydown="NewProgramKey" @ref="newProgramInput" />
                <button class="btn btn-sm btn-primary" @onclick="CreateProgram">Create</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => newProgramName = null">Cancel</button>
            </span>
        }
    </div>
    <AssemblyEditor Value="@Program" ValueChanged="OnProgramChanged" Microcode="Definition.Decoder?.Microcode" MemorySize="ProgramMemorySize" RegisterCount="RegisterFile.CountIn(Definition)" />
    <ErrorList Errors="@ProgramErrors.Where(e => !e.StartsWith("Line ")).ToList()" />
}
else if (ActiveTab == "Run")
{
    @if (C == null)
    {
        <div class="alert alert-warning">The machine can not run until these problems are fixed:</div>
        <ErrorList Errors="AllErrors.ToList()" />
    }
    else
    {
        <RunView Machine="C" Registry="Registry" OnRestart="Rebuild" MachineName="@Definition.Name" ProgramName="@ProgramTitle" />
    }
}
</div>

@if (drawerOpen)
{
    <GettingStarted Package="Package" IsBuiltIn="IsBuiltIn" Workspace="workspace" @bind-Section="drawerSection" @bind-Page="drawerPage" OnClose="() => drawerOpen = false"
                    OnLoadPackage="OpenByName" OnResetPackage="ResetPackage" OnDeletePackage="DeletePackage" OnExportPackage="ExportByName" OnStartOver="StartOver"
                    OnReadmeChanged="MarkChanged" OnLink="FollowLink"
                    DefinitionJson="@DefinitionJson" JsonErrors="ParseErrors" OnJsonChanged="OnJsonChanged" />
}
