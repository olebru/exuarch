<select class="form-select form-select-sm" value="@(Value ?? "")" @onchange="e => OnChange.InvokeAsync((string)e.Value)">
    <option value="">@Empty</option>
    @foreach (var choice in Choices) { <option value="@choice.Value">@choice.Label</option> }
</select>

@code
{
    // A choice of a bus or a device by its id, or of none: the empty value.
    [Parameter] public string Value { get; set; }
    [Parameter] public string Empty { get; set; } = "— none —";
    [Parameter] public IEnumerable<(string Value, string Label)> Choices { get; set; }
    [Parameter] public EventCallback<string> OnChange { get; set; }
}
