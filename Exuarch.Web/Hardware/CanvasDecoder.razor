@if (Decoder?.Layout != null)
{
    <DeviceCard Id="decoder" Kind="decoder rom" Layout="Layout" Color="var(--cat-control)"
                CssClass="@($"decoder {(Design.Selection.IsDecoder ? "selected" : "")} {(Design.DecoderHasProblem ? "problem" : "")}")"
                HeadTitle="The decoder runs the microcode: every tick it reads the next step from its ROM and turns on that step's control lines"
                Left="Decoder.Layout.X" Top="Decoder.Layout.Y" Height="SchematicLayout.DecoderHeight" Sockets="DeviceCard.DecoderSocketsOf(Layout)"
                Line="step" LineValue="@(Design.DecoderStep is int step ? Hex(step) : "—")"
                SubLine="@(Decoder.Microcode == null ? "no microcode" : $"{Decoder.Microcode.Instructions.Count} instructions")"
                OnCardPointerDown="e => OnGesture.InvokeAsync(new(e, new MoveDecoderGesture(Design)))"
                OnSocketPointerDown="a => OnGesture.InvokeAsync(new(a.Item1, new WireDecoderGesture(Design, a.Item2)))" />
}

@code
{
    // The decoder, drawn as a card like the devices: its sockets name the devices it works with.
    [Parameter] public MachineDesign Design { get; set; }
    [Parameter] public SchematicLayout Layout { get; set; }
    [Parameter] public EventCallback<GestureStart> OnGesture { get; set; }

    private DecoderDefinition Decoder => Design.Definition.Decoder;
}
