<span class="seven-segment @Size" role="img" aria-label="@Text.Trim()">
    @foreach (var character in Text)
    {
        var lit = SegmentsOf(character);
        <svg class="digit" viewBox="0 0 @DigitWidth @DigitHeight" aria-hidden="true">
            @for (int segment = 0; segment < Shapes.Length; segment++)
            {
                <polygon class="@(((lit >> segment) & 1) != 0 ? "on" : "")" points="@Shapes[segment]" />
            }
        </svg>
    }
</span>

@code
{
    private const int DigitWidth = 56;
    private const int DigitHeight = 100;

    private static readonly string[] Shapes =
    {
        "8,8 14,2 42,2 48,8 42,14 14,14",
        "50,10 56,16 56,42 50,48 44,42 44,16",
        "50,52 56,58 56,84 50,90 44,84 44,58",
        "8,92 14,86 42,86 48,92 42,98 14,98",
        "6,52 12,58 12,84 6,90 0,84 0,58",
        "6,10 12,16 12,42 6,48 0,42 0,16",
        "8,50 14,44 42,44 48,50 42,56 14,56",
    };

    private static readonly Dictionary<char, int> Glyphs = new Dictionary<char, int>
    {
        ['0'] = 0b0111111, ['1'] = 0b0000110, ['2'] = 0b1011011, ['3'] = 0b1001111,
        ['4'] = 0b1100110, ['5'] = 0b1101101, ['6'] = 0b1111101, ['7'] = 0b0000111,
        ['8'] = 0b1111111, ['9'] = 0b1101111, ['A'] = 0b1110111, ['B'] = 0b1111100,
        ['C'] = 0b0111001, ['D'] = 0b1011110, ['E'] = 0b1111001, ['F'] = 0b1110001,
        ['-'] = 0b1000000,
    };

    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string Size { get; set; } = "segments-panel";

    private static int SegmentsOf(char character) => Glyphs.TryGetValue(char.ToUpperInvariant(character), out var lit) ? lit : 0;
}
