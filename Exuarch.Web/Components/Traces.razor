@code
{
    public static RenderFragment Bus(string id, double y, double canvasWidth, string color, string css) => @<text><rect class="@css" x="16" y="@N(y - 3)" width="@N(canvasWidth - 32)" height="6" rx="1" fill="@color" /><text class="bus-label" x="24" y="@N(y - 12)" fill="@color">@($"{id}[15:0]")</text><line class="bus-slash" x1="112" y1="@N(y + 8)" x2="122" y2="@N(y - 8)" /><text class="bus-width" x="125" y="@N(y - 10)">16</text></text>;

    public static RenderFragment Tap(double x, double y, string color) => @<circle class="bus-tap" cx="@N(x)" cy="@N(y)" r="3" fill="@color" />;

    public static RenderFragment Connection(string path, string css, string marker) => @<path class="@css" d="@path" marker-end="@marker" />;
}
