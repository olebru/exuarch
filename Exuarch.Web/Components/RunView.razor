@if (Machine != null)
{
    var definition = Machine.Definition;
    var timeline = TimelineInstruction;
    var current = ListingAt(Machine.CurrentInstructionAddress);
<div class="run" tabindex="0" @ref="runElement" @onkeydown="OnKeyDown" @onkeyup="OnKeyUp" @onkeydown:preventDefault="capturedKeypad != null" @onfocusout="ReleaseKeys"
     style="--left-width:@Px(LeftWidth); --right-width:@Px(RightWidth); --bottom-height:@Px(BottomHeight)">

    <!-- Controls -->
    <div class="controls">
        <button class="ctl primary" title="Run / pause (Space)" disabled="@(Machine.IsHalted || runtimeError != null)" @onclick="ToggleRun">
            @(running ? "❚❚ Pause" : "▶ Run")
        </button>
        <button class="ctl" title="One clock tick (→)" disabled="@(running || Machine.IsHalted || runtimeError != null)" @onclick="TickOnce">Tick</button>
        <button class="ctl" title="Run the current instruction and fetch the next (Shift+→)" disabled="@(running || Machine.IsHalted || runtimeError != null)" @onclick="StepInstruction">Instruction</button>
        <button class="ctl" title="Reload the program and reset every device (R)" @onclick="Restart">⟲ Reset</button>
        <span class="sep"></span>
        <label class="speed @(maxSpeed ? "off" : "")" title="Clock speed while running">
            <input type="range" min="0" max="@SliderSteps" disabled="@maxSpeed" @bind="speedSlider" @bind:event="oninput" />
            <span>@(maxSpeed ? "max" : ShortHz(Hz))</span>
        </label>
        <button class="ctl @(maxSpeed ? "on" : "")" title="Run as fast as the browser allows, ignoring the slider (M). To leave the machine more time, the view is redrawn less often and the trace skips ticks" @onclick="() => maxSpeed = !maxSpeed">⚡ Max</button>
        <span class="sep"></span>
        <button class="ctl @(Collapsed("left") ? "" : "on")" title="Show or fold away the left column" @onclick="@(() => TogglePanel("left"))">◧ Left</button>
        <button class="ctl @(Collapsed("right") ? "" : "on")" title="Show or fold away the right column" @onclick="@(() => TogglePanel("right"))">Right ◨</button>
        <button class="ctl" title="Put every panel back where it started, at its first size" @onclick="ResetLayout">Reset layout</button>
        <span class="grow"></span>
        @if (!string.IsNullOrEmpty(ProgramName))
        {
            <span class="loaded" title="@($"{MachineName} running {ProgramName}")">
                @if (!string.IsNullOrEmpty(MachineName)) { <span class="loaded-machine">@MachineName</span><span class="loaded-sep">/</span> }
                <span class="loaded-program">@ProgramName</span>
            </span>
        }
        <span class="cycle">cycle <strong>@Machine.Cycles</strong></span>
        <span class="state state-@State">@State</span>
    </div>
    @if (runtimeError != null)
    {
        <div class="runtime-error">⚠ @runtimeError</div>
    }
    @if (KeypadMissing || SpeedTooLow || SpeedNotExact)
    {
        <div class="program-needs" role="status">
            @if (KeypadMissing)
            {
                <span class="need">⚠ @(ProgramName ?? "This program") reads the keypad: capture the keyboard so the arrows and space go to it.
                    <button class="ctl" @onclick="CaptureFirstKeypad">Capture keyboard</button></span>
            }
            @if (SpeedTooLow)
            {
                var minHz = ProgramNeeds.MinHz.Value;
                <span class="need">⚠ Needs a clock of at least @ShortHz(minHz) to work; the slider is at @ShortHz(Hz).
                    @if (ClockSlider.StepAtLeast(minHz) != null) { <button class="ctl" @onclick="MeetMinHz">Set @ShortHz(minHz)</button> }
                    <button class="ctl" @onclick="() => maxSpeed = true">⚡ Max</button></span>
            }
            @if (SpeedNotExact)
            {
                var exactHz = ProgramNeeds.ExactHz.Value;
                <span class="need">⚠ Needs a clock of exactly @ShortHz(exactHz) to work; @(maxSpeed ? "⚡ Max is on" : $"the slider is at {ShortHz(Hz)}").
                    <button class="ctl" @onclick="MeetExactHz">Set @ShortHz(ClockSlider.Nearest(exactHz))</button></span>
            }
        </div>
    }

    <!-- Control word: every control line, lit when enabled this tick -->
    <div class="control-strip @(Collapsed("lines") ? "collapsed" : "")" title="Control lines driven by the decoder ROM this tick">
        <button class="strip-title panel-toggle" title="@(Collapsed("lines") ? "Show every control line" : "Show only the lines that are on")" @onclick="@(() => TogglePanel("lines"))"><i class="chev"></i>control lines</button>
        @{ var anyOn = false; }
        @foreach (var group in ControlLines)
        {
            var groupInfo = Info(group.Device);
            var shownLines = Collapsed("lines") ? group.Lines.Where(l => LineActive(group.Device.Id, l)).ToList() : group.Lines;
            if (shownLines.Count == 0) continue;
            anyOn = true;
            <span class="line-group" style="--cat:@group.Color">
                <span class="line-device" title="@($"{group.Device.Type}: {groupInfo.Description}")">@group.Device.Id</span>
                @foreach (var line in shownLines)
                {
                    var lineDescription = groupInfo.ControlLines.FirstOrDefault(l => l.Name == line)?.Description;
                    <span class="led @(LineActive(group.Device.Id, line) ? "on" : "")" title="@($"{group.Device.Id}.{line}{(string.IsNullOrEmpty(lineDescription) ? "" : ": " + lineDescription)}")">@line</span>
                }
            </span>
        }
        @if (!anyOn) { <span class="muted">none on this tick</span> }
    </div>

    <div class="main">
        @{ RenderColumn(__builder, "left"); }
        <!-- Live schematic -->
        <div class="schematic" @ref="schematicElement">
            <div class="zoom">
                <button title="Zoom out" @onclick="() => Zoom(1 / 1.15)">−</button>
                <button title="Actual size, or as small as it takes to fit the width" @onclick="Fit">@((int)Math.Round(zoom * 100))%</button>
                <button title="Zoom in" @onclick="() => Zoom(1.15)">＋</button>
            </div>
            <div class="schematic-sizer" style="width:@Px(Layout.CanvasWidth * zoom); height:@Px(Layout.CanvasHeight * zoom)">
            <div class="schematic-canvas" style="width:@Px(Layout.CanvasWidth); height:@Px(Layout.CanvasHeight); transform:scale(@N(zoom))">
                <svg width="@N(Layout.CanvasWidth)" height="@N(Layout.CanvasHeight)" class="wires">
                    <defs>
                        <marker id="run-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                            <path d="M 0 0 L 10 5 L 0 10 z" fill="context-stroke" />
                        </marker>
                        <marker id="run-link" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                            <path class="arrow-head" d="M 0 0 L 10 5 L 0 10 z" />
                        </marker>
                    </defs>
                    @foreach (var bus in definition.Buses.Where(b => b.Layout != null))
                    {
                        var y = bus.Layout.Y;
                        var color = BusColor(bus.Id);
                        var transfer = TransferOn(bus.Id);
                        <g>
                            <rect class="bus-bar @(transfer != null ? "live" : "")" x="16" y="@N(y - 3)" width="@N(Layout.CanvasWidth - 32)" height="6" rx="1" fill="@color" />
                            <text class="bus-label" x="24" y="@N(y - 12)" fill="@color">@($"{bus.Id}[15:0]")</text>
                            <line class="bus-slash" x1="@N(112)" y1="@N(y + 8)" x2="@N(122)" y2="@N(y - 8)" />
                            <text class="bus-width" x="@N(125)" y="@N(y - 10)">16</text>
                        </g>
                    }
                    @foreach (var device in definition.Devices.Where(d => d.Layout != null))
                    {
                        foreach (var port in device.Ports())
                        {
                            if (definition.FindBus(port.Value)?.Layout == null) continue;
                            var anchor = Layout.PortAnchor(device, port.Key);
                            var busY = Layout.BusY(port.Value);
                            var color = BusColor(port.Value);
                            if (Drives(device.Id, port.Value))
                            {
                                <line class="wire drive" x1="@N(anchor.X)" y1="@N(anchor.Y)" x2="@N(anchor.X)" y2="@N(busY)" stroke="@color" marker-end="url(#run-arrow)" />
                            }
                            else if (Reads(device.Id, port.Value))
                            {
                                <line class="wire read" x1="@N(anchor.X)" y1="@N(busY)" x2="@N(anchor.X)" y2="@N(anchor.Y)" stroke="@color" marker-end="url(#run-arrow)" />
                            }
                            else
                            {
                                <line class="wire idle" x1="@N(anchor.X)" y1="@N(anchor.Y)" x2="@N(anchor.X)" y2="@N(busY)" />
                            }
                            <circle class="bus-tap" cx="@N(anchor.X)" cy="@N(busY)" r="3" fill="@color" />
                        }
                        var connections = Info(device).Connections;
                        for (int i = 0; i < connections.Count; i++)
                        {
                            if (!device.Connections.TryGetValue(connections[i].Name, out var targetId)) continue;
                            var target = definition.FindDevice(targetId);
                            if (target?.Layout == null) continue;
                            <path class="connection-wire" d="@Layout.ConnectionPath(device, i, target)" marker-end="url(#run-link)" />
                        }
                    }
                    @if (definition.Decoder?.Layout != null)
                    {
                        for (int i = 0; i < SchematicLayout.DecoderSockets.Length; i++)
                        {
                            var target = definition.FindDevice(Layout.DecoderTarget(SchematicLayout.DecoderSockets[i].Name) ?? "");
                            if (target?.Layout == null) continue;
                            <path class="connection-wire decoder-wire" d="@Layout.DecoderPath(i, target)" marker-end="url(#run-link)" />
                        }
                    }
                    @foreach (var bus in definition.Buses)
                    {
                        var transfer = TransferOn(bus.Id);
                        if (transfer == null) continue;
                        var driver = definition.FindDevice(transfer.Driver ?? "");
                        if (driver?.Layout == null || bus.Layout == null) continue;
                        var port = driver.Ports().First(p => p.Value == bus.Id).Key;
                        var x = Layout.PortAnchor(driver, port).X;
                        var y = bus.Layout.Y;
                        <g class="bus-value" @key="@($"{Last.Cycle}:{bus.Id}")">
                            <rect x="@N(x - 26)" y="@N(y - 11)" width="52" height="22" rx="2" stroke="@BusColor(bus.Id)" stroke-width="1.5" />
                            <text x="@N(x)" y="@N(y + 5)" text-anchor="middle" fill="@BusColor(bus.Id)">@Hex(transfer.Value)</text>
                        </g>
                    }
                </svg>

                @foreach (var device in definition.Devices.Where(d => d.Layout != null))
                {
                    var info = Info(device);
                    var built = Machine.Device(device.Id);
                    var driving = device.Ports().Where(p => Drives(device.Id, p.Value)).Select(p => p.Value).FirstOrDefault();
                    var reading = device.Ports().Any(p => Reads(device.Id, p.Value));
                    <DeviceCard Device="device" Layout="Layout" Id="@device.Id" Kind="@(device.Name ?? device.Type)" HeadTitle="@($"{device.Type}: {info.Description}")"
                                Left="device.Layout.X" Top="device.Layout.Y" Height="Layout.CardHeight(device)" Color="@CategoryColor(info)" BusColor="BusColor"
                                CssClass="@($"{(IsActive(device.Id) ? "active" : "")} {(driving != null ? "driving" : "")} {(reading ? "reading" : "")}")"
                                Built="built" Machine="Machine" Signals="SignalsOf(device.Id).ToList()" AluResult="@(driving != null ? TransferOn(driving).Value : null)"
                                Changed="Changed(device.Id)" ChangeKey="@(Last?.Cycle ?? 0)" Sockets="DeviceCard.SocketsOf(device, info)" />
                }
                @if (definition.Decoder?.Layout != null)
                {
                    var decoderLayout = definition.Decoder.Layout;
                    <DeviceCard Id="decoder" Kind="decoder rom" Layout="Layout" CssClass="decoder" Color="var(--cat-control)"
                                HeadTitle="The decoder runs the microcode: every tick it reads the next step from its ROM and turns on that step's control lines"
                                Left="decoderLayout.X" Top="decoderLayout.Y" Height="SchematicLayout.DecoderHeight" Sockets="DeviceCard.DecoderSocketsOf(Layout)"
                                Line="ROM" LineValue="@RomHex(DecoderRom.RomAddress(DecoderStatus, DecoderStep))" SubLine="@($"{Machine.DecoderRom.Microcode.Instructions.Count} instructions")" />
                }
            </div>
            </div>
        </div>

        @{ RenderColumn(__builder, "right"); }
    </div>

    <!-- Bottom: the panels shown as tabs, in one group or two side by side -->
    @{ var docks = Docks(); }
    @if (docks["bottom"].Count > 0 || docks["bottom2"].Count > 0 || draggedPanel != null)
    {
    @if (!Collapsed("bottom")) { <div class="splitter splitter-h" data-resize="bottom" title="Drag to resize the panels below; double-click to reset"></div> }
    <div class="bottom @(Collapsed("bottom") ? "collapsed" : "") @(BottomSplit ? "split" : "")" style="--bottom-split:@(runLayout.BottomSplitPercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%">
        @{ RenderBottomGroup(__builder, "bottom", docks["bottom"]); }
        @if (BottomSplit)
        {
            @if (!Collapsed("bottom")) { <div class="splitter splitter-v" data-resize="split" title="Drag to share the width between the two groups; double-click to reset"></div> }
            RenderBottomGroup(__builder, "bottom2", docks["bottom2"]);
        }
    </div>
    }
</div>
}

@code
{

    // One group of tabs below and the panel on show in it. The first has the toggles that fold the panels below away
    // and split them in two.
    private void RenderBottomGroup(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder, string dock, List<Panel> group)
    {
        var activeTab = ActiveTab(group, dock);
        <div class="bottom-group bottom-group-@dock">
            <div class="bottom-tabs">
                @if (dock == "bottom")
                {
                    <button class="panel-toggle bottom-toggle" title="@(Collapsed("bottom") ? "Show the panels below" : "Hide the panels below")" @onclick="@(() => TogglePanel("bottom"))"><i class="chev"></i></button>
                    <button class="bottom-split-toggle @(BottomSplit ? "on" : "")" title="@(BottomSplit ? "Put the panels below back in one group" : "Split the panels below into two groups side by side")" @onclick="ToggleBottomSplit">◫</button>
                }
                @foreach (var panel in group)
                {
                    var id = panel.Id;
                    <button class="btab @(!Collapsed("bottom") && activeTab?.Id == id ? "on" : "") @(dropBefore == (dock, id) ? "drop-before" : "")" @key="id" draggable="true" title="Click to show; drag to move"
                            @onclick="@(() => ShowBottom(dock, id))" @ondragstart="() => StartPanelDrag(id)" @ondragend="EndPanelDrag"
                            @ondragover:preventDefault @ondragenter="@(() => DragOver(dock, id))" @ondrop="@(() => DropPanel(dock, id))">@panel.Title@if (panel.Detail != null) { <span class="btab-detail">@panel.Detail</span> }</button>
                }
                <span class="tab-end @(dropBefore == (dock, null) ? "drop-before" : "")" @ondragover:preventDefault @ondragenter="@(() => DragOver(dock, null))" @ondrop="@(() => DropPanel(dock, null))">
                    @if (draggedPanel != null) { <span class="muted">drop here for a tab</span> }
                </span>
                @if (activeTab?.Help != null) { <HelpLink Target="@activeTab.Help.Value.Target" Title="@activeTab.Help.Value.Title" /> }
                @if (!Collapsed("bottom") && activeTab != null && HasTools(activeTab.Id))
                {
                    <span class="sep"></span>
                    RenderTools(__builder, activeTab.Id);
                }
            </div>
            @if (!Collapsed("bottom") && activeTab != null)
            {
                <div class="bottom-body @(activeTab.Id is "program" or "memory" or "decoder" or "trace" ? "" : "padded")">
                    @if (activeTab.Id == "clock") { <div class="clock-head bottom-clock">@{ RenderHeadExtra(__builder, "clock"); }</div> }
                    @{ RenderBody(__builder, activeTab.Id); }
                </div>
            }
        </div>
    }

    // A column of panels on one side of the drawing, with its resize handle on the drawing's side. Folded away, it is a
    // slim rail that opens it again, and that a panel can be dropped on.
    private void RenderColumn(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder, string dock)
    {
        var panels = Column(dock);
        if (Collapsed(dock))
        {
            <button class="rail rail-@dock @(dropBefore == (dock, null) ? "drop-before" : "")" title="Show the @dock column (@panels.Count panel@(panels.Count == 1 ? "" : "s"))"
                    @onclick="@(() => TogglePanel(dock))" @ondragover:preventDefault @ondragenter="@(() => DragOver(dock, null))" @ondrop="@(() => DropPanel(dock, null))">
                <span class="rail-label">@dock · @panels.Count</span>
            </button>
            return;
        }
        if (panels.Count == 0 && draggedPanel == null) return;
        if (dock == "right")
        {
            <div class="splitter splitter-v" data-resize="right" title="Drag to resize the right column; double-click to reset"></div>
        }
        <div class="side side-@dock">
            @foreach (var panel in panels)
            {
                var id = panel.Id;
                <div class="panel @panel.Css @(Collapsed(id) ? "collapsed" : "") @(dropBefore == (dock, id) ? "drop-before" : "")" @key="id"
                     @ondragover:preventDefault @ondragenter="@(() => DragOver(dock, id))" @ondrop="@(() => DropPanel(dock, id))">
                    <div class="panel-head @(id == "clock" ? "clock-head" : "")">
                        <span class="grip" draggable="true" title="Drag to move this panel" @ondragstart="() => StartPanelDrag(id)" @ondragend="EndPanelDrag">⋮⋮</span>
                        <button class="panel-title panel-toggle" @onclick="@(() => TogglePanel(id))"><i class="chev"></i>@panel.Title @if (panel.Detail != null) { <span class="muted">@panel.Detail</span> }</button>
                        @{ RenderHeadExtra(__builder, id); }
                        @if (panel.Help != null) { <HelpLink Target="@panel.Help.Value.Target" Title="@panel.Help.Value.Title" /> }
                    </div>
                    @if (!Collapsed(id))
                    {
                        @if (HasTools(id)) { <div class="panel-tools">@{ RenderTools(__builder, id); }</div> }
                        <div class="panel-body @(panel.Scrolls ? "scrolls" : "")">@{ RenderBody(__builder, id); }</div>
                    }
                </div>
            }
            <div class="dock-end @(dropBefore == (dock, null) ? "drop-before" : "")" @ondragover:preventDefault @ondragenter="@(() => DragOver(dock, null))" @ondrop="@(() => DropPanel(dock, null))">
                @if (draggedPanel != null) { <span class="muted">drop here to put it last</span> }
            </div>
        </div>
        if (dock == "left")
        {
            <div class="splitter splitter-v" data-resize="left" title="Drag to resize the left column; double-click to reset"></div>
        }
    }
    // A panel's own line next to its title: the clock's speeds, and the instruction running when Now executing is folded.
    private void RenderHeadExtra(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder, string id)
    {
        if (id == "clock")
        {
            <span class="muted clock-target">@(maxSpeed ? "target: max" : $"target {FormatHz(Hz)}") · peak @FormatHz(PeakHz)</span>
            <span class="clock-now">@(running || speedSamples.Count > 0 ? FormatHz(CurrentHz) : "—")</span>
        }
        else if (id == "now" && Collapsed("now") && ListingAt(Machine.CurrentInstructionAddress) is { } current)
        {
            <span class="now-inline">@SourceText(current)</span>
        }
    }

    private bool HasTools(string id) => id is "memory" or "decoder";

    // The controls that go with a panel, wherever it is: in the side panel's head, or the tab bar below.
    private void RenderTools(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder, string id)
    {
        if (id == "decoder")
        {
            <label class="bank"><input type="checkbox" @bind="wholeRom" /> whole ROM</label>
            <span class="legend muted">@Machine.DecoderRom.OpCodesUsed of @DecoderRom.AddressSpace step addresses used · rows shown for status @Bits(DecoderStatus, 5) (INVCZ)</span>
        }
        else if (id == "memory")
        {
            @foreach (var device in MemoryDevices)
            {
                <button class="btab small @(memoryDevice == device.ID() ? "on" : "")" @onclick="() => memoryDevice = device.ID()">@device.ID()</button>
            }
            @if (Machine.Device(memoryDevice) is MMU mmuDevice)
            {
                <label class="bank">bank
                    <input type="number" min="0" max="255" @bind="memoryBank" />
                    <button class="btab small" @onclick="() => memoryBank = mmuDevice.SelectedBankNumber">selected (@mmuDevice.SelectedBankNumber)</button>
                </label>
            }
            @if (MemoryModule is MemoryModule paged && PageCount(paged) > 1)
            {
                <span class="pager">
                    <button class="btab small" disabled="@(Page(paged) == 0)" @onclick="() => memoryPage = Page(paged) - 1">‹</button>
                    page @(Page(paged) + 1) / @PageCount(paged)
                    <button class="btab small" disabled="@(Page(paged) == PageCount(paged) - 1)" @onclick="() => memoryPage = Page(paged) + 1">›</button>
                    <button class="btab small" @onclick="() => GoToMar(paged)">go to MAR</button>
                </span>
            }
            <span class="legend">
                <span class="lg pc">PC</span><span class="lg mar">MAR</span><span class="lg current">instruction</span><span class="lg written">written</span>
            </span>
        }
    }

    private void RenderBody(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder, string id)
    {
        var current = ListingAt(Machine.CurrentInstructionAddress);
        var timeline = TimelineInstruction;
        if (id == "clock")
        {
            <svg class="clock-chart" viewBox="0 0 @N(ChartWidth) @N(ChartHeight)" preserveAspectRatio="none">
                <line class="grid" x1="0" y1="@N(ChartHeight / 2)" x2="@N(ChartWidth)" y2="@N(ChartHeight / 2)" />
                @if (!maxSpeed)
                {
                    <line class="target" x1="0" y1="@N(TargetY)" x2="@N(ChartWidth)" y2="@N(TargetY)" />
                }
                @if (speedSamples.Count > 0)
                {
                    <polygon class="area" points="@SpeedPoints(true)" />
                    <polyline class="line" points="@SpeedPoints(false)" />
                }
            </svg>
            <div class="clock-axis"><span>@FormatHz(ChartMax)</span><span>last @((int)Math.Round(ChartSpan)) s of running</span></div>
        }
        else if (id.StartsWith("device:") && Machine.Device(id.Substring(7)) is IScreen screen)
        {
            <FramebufferView Screen="screen" />
        }
        else if (id.StartsWith("device:") && Machine.Device(id.Substring(7)) is CharacterDisplay display)
        {
            var write = Last?.Writes.FirstOrDefault(w => w.Device == display.ID());
            <CharacterDisplayView Display="display" LastWritten="@(write?.Address ?? -1)" Cycle="@(Last?.Cycle ?? 0)" />
        }
        else if (id.StartsWith("device:") && Machine.Device(id.Substring(7)) is Keypad keypad)
        {
            <KeypadView Keypad="keypad" Captured="@(capturedKeypad == keypad)" CaptureChanged="captured => Capture(captured ? keypad : null)" Changed="StateHasChanged" />
        }
        else if (id == "now")
        {
            @if (current != null)
            {
                <div class="now-instr">
                    <span class="addr">@Hex(current.Address)</span>
                    @if (current.Label != null) { <span class="label">@current.Label:</span> }
                    <span class="src">@SourceText(current)</span>
                </div>
                <div class="now-desc">@(InstructionNamed(current.Mnemonic)?.Description)</div>
            }
            else
            {
                <div class="now-desc">No instruction fetched yet. Press Tick or Instruction.</div>
            }

            @if (timeline.Instruction != null)
            {
                var variant = timeline.Instruction.StepsFor(timeline.Status);
                var next = Machine.NextStep;
                <div class="timeline-title">
                    <strong>@timeline.Instruction.Mnemonic</strong> micro steps
                    @if (timeline.Instruction.Steps.Any(s => s.When != null)) { <span class="muted">for the current flags</span> }
                </div>
                <ol class="timeline">
                    @for (int i = 0; i < variant.Count; i++)
                    {
                        var step = variant[i];
                        var index = timeline.Instruction.Steps.IndexOf(step);
                        var ranIndex = timeline.RanIndex.HasValue ? variant.FindIndex(v => timeline.Instruction.Steps.IndexOf(v) == timeline.RanIndex) : -1;
                        var isNext = next != null && next.Value.Instruction == timeline.Instruction && next.Value.Step == step;
                        var state = index == timeline.RanIndex ? "ran" : isNext ? "next" : i < ranIndex ? "done" : "todo";
                        <li class="tl tl-@state">
                            <span class="tl-mark">@(state == "ran" ? "●" : state == "next" ? "▶" : state == "done" ? "✓" : (i + 1).ToString())</span>
                            <span class="tl-signals">@foreach (var signal in step.Signals) { <span class="chip">@signal</span> }</span>
                        </li>
                    }
                </ol>
                @if (next != null && next.Value.Instruction != timeline.Instruction)
                {
                    <div class="up-next">next tick: <strong>@next.Value.Instruction.Mnemonic</strong> step @(next.Value.Offset + 1)</div>
                }
            }

            @if (Last != null)
            {
                <div class="timeline-title">Last tick <span class="muted">cycle @Last.Cycle</span></div>
                <div class="last-tick">
                    @foreach (var transfer in Last.Transfers)
                    {
                        <div class="flow" style="--bus:@BusColor(transfer.Bus)">
                            @if (transfer.Driver == null)
                            {
                                <span class="muted">@transfer.Bus floating</span>
                            }
                            else
                            {
                                <span class="who">@transfer.Driver</span><span class="arrow">→</span>
                                <span class="busname">@transfer.Bus <strong>@Hex(transfer.Value)</strong></span><span class="arrow">→</span>
                                <span class="who">@(transfer.Readers.Count == 0 ? "nobody" : string.Join(", ", transfer.Readers))</span>
                            }
                        </div>
                    }
                    @foreach (var change in Last.Changes)
                    {
                        <div class="change">@change.Device <span class="muted">@Hex(change.Before) →</span> <strong>@Hex(change.After)</strong></div>
                    }
                    @foreach (var write in Last.Writes)
                    {
                        <div class="change">write @write.Device@(write.Bank >= 0 ? $" bank {write.Bank}" : "") [@Hex(write.Address)] = <strong>@Hex(write.Value)</strong></div>
                    }
                </div>
            }
        }
        else if (id == "program")
        {
            <div class="listing" style="--d:@Digits; --lw:@ListingLabelChars">
                @foreach (var line in Machine.Assembler.Listing)
                {
                    var isCurrent = line.IsInstruction && line.Address == Machine.CurrentInstructionAddress;
                    <div id="listing-@(isCurrent ? line.Address.ToString() : "")" class="lst @(isCurrent ? "current" : "") @(line.IsInstruction ? "" : "data")" title="@CellsTitle(line)">
                        @if (line.IsInstruction)
                        {
                            <span class="bp @(breakpoints.Contains(line.Address) ? "on" : "")" @onclick="() => ToggleBreakpoint(line.Address)" title="Toggle breakpoint"></span>
                        }
                        else
                        {
                            <span class="bp none"></span>
                        }
                        <span class="addr">@Hex(line.Address)</span>
                        <span class="label">@(line.Label == null ? "" : line.Label + ":")</span>
                        <span class="src">@(line.IsInstruction ? SourceText(line) : line.Mnemonic == null ? "" : $"{line.Mnemonic} {string.Join(", ", line.Operands)}")</span>
                    </div>
                }
            </div>
        }
        else if (id == "memory" && MemoryModule != null)
        {
            var module = MemoryModule;
            var pageStart = Page(module) * PageSize;
            var addressDigits = AddressDigits(module);
            var marks = MarksFor(module);
            <div class="memory" style="--digits:@Digits; --adigits:@addressDigits">
                <div class="mem-row head"><span class="mem-addr">addr</span>@for (int c = 0; c < 16; c++) { <span class="cell">@c.ToString("X")</span> }<span class="ascii">ascii</span></div>
                @for (int rowStart = pageStart; rowStart < Math.Min(pageStart + PageSize, module.Size); rowStart += 16)
                {
                    var start = rowStart;
                    <div class="mem-row">
                        <span class="mem-addr">@start.ToString("X" + addressDigits)</span>
                        @for (int address = start; address < Math.Min(start + 16, module.Size); address++)
                        {
                            <span class="cell @CellClass(address, module, marks)" title="[@address.ToString("X" + addressDigits)] = @module.ValueAt(address)">@Hex(module.ValueAt(address))</span>
                        }
                        <span class="ascii">
                            @for (int address = start; address < Math.Min(start + 16, module.Size); address++)
                            {
                                var low = module.ValueAt(address) & 0xFF;
                                var printable = low >= 0x20 && low < 0x7F;
                                <span class="ch @CellClass(address, module, marks) @(printable ? "" : "blank")">@(printable ? ((char)low).ToString() : "·")</span>
                            }
                        </span>
                    </div>
                }
            </div>
        }
        else if (id == "decoder")
        {
            var groups = ControlLines;
            <div class="decoder">
                <div class="address">
                    <div class="address-title">decoder address</div>
                    <div class="address-bits">
                        <span class="field status">
                            @for (int i = 0; i < 5; i++) { <span class="bit @(Bits(DecoderStatus, 5)[i] == '1' ? "one" : "")" title="@(i == 0 ? "I: an interrupt request, sampled when an instruction starts" : "")">@("INVCZ"[i])<br />@Bits(DecoderStatus, 5)[i]</span> }
                            <span class="field-name">status</span>
                        </span>
                        <span class="field step">
                            @for (int i = 0; i < StepBits; i++) { <span class="bit @(Bits(DecoderStep, StepBits)[i] == '1' ? "one" : "")">@(StepBits - 1 - i)<br />@Bits(DecoderStep, StepBits)[i]</span> }
                            <span class="field-name">micro step register</span>
                        </span>
                    </div>
                    <div class="address-value">= ROM address <strong>@RomHex(DecoderRom.RomAddress(DecoderStatus, DecoderStep))</strong></div>
                    <div class="address-next muted">next tick reads @RomHex(NextAddress)</div>
                </div>
                <div class="rom">
                    <table class="rom-table">
                        <thead>
                            <tr>
                                <th class="rom-addr" rowspan="2">addr</th>
                                <th class="rom-label" rowspan="2">step</th>
                                @foreach (var group in groups) { <th class="rom-device" colspan="@group.Lines.Count" style="--cat:@group.Color">@group.Device.Id</th> }
                            </tr>
                            <tr>
                                @foreach (var group in groups)
                                {
                                    for (int i = 0; i < group.Lines.Count; i++)
                                    {
                                        var line = group.Lines[i];
                                        <th class="rom-line @(LineActive(group.Device.Id, line) ? "on" : "") @(i == 0 ? "first" : "")"><span>@line</span></th>
                                    }
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in RomRows)
                            {
                                var isCurrent = Last != null && row.Address == DecoderStep;
                                <tr class="@(isCurrent ? "current" : "") @(row.BlockStart ? "block-start" : "")">
                                    <td class="rom-addr">@RomHex(DecoderRom.RomAddress(DecoderStatus, row.Address))</td>
                                    <td class="rom-label">@row.Label</td>
                                    @foreach (var group in groups)
                                    {
                                        for (int i = 0; i < group.Lines.Count; i++)
                                        {
                                            var signal = $"{group.Device.Id}.{group.Lines[i]}";
                                            <td class="rom-cell @(i == 0 ? "first" : "")">@if (row.Signals.Contains(signal)) { <span class="dot" style="background:@group.Color"></span> }</td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (id == "trace")
        {
            <div class="trace">
                <div class="tr head"><span>cycle</span><span>micro step</span><span>bus</span><span>changes</span><span>signals</span></div>
                @foreach (var tick in Machine.History.Reverse().Take(TraceRows))
                {
                    <div class="tr @(tick.FetchedFromAddress != null ? "fetch" : "")">
                        <span>@tick.Cycle</span>
                        <span>@tick.Instruction@(tick.StepIndex.HasValue ? $".{tick.StepIndex + 1}" : "")</span>
                        <span>@DescribeTransfers(tick)</span>
                        <span>@DescribeChanges(tick)</span>
                        <span class="muted">@string.Join(" ", tick.Signals)</span>
                    </div>
                }
            </div>
        }
    }
}
