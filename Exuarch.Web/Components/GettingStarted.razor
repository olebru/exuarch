@using Exuarch.Core
@inject IJSRuntime JS

<aside class="drawer @(editing || (Section == "This machine" && machineView == "JSON") ? "wide" : "")" aria-label="Getting started">
    <div class="drawer-head">
        <span class="drawer-title">Getting started</span>
        <span class="grow"></span>
        <button class="drawer-close" title="Close" @onclick="OnClose">×</button>
    </div>
    <div class="drawer-sections">
        @foreach (var section in Sections)
        {
            <button class="drawer-section @(Section == section ? "on" : "")" @onclick="() => Show(section)">@section</button>
        }
    </div>
    <div class="drawer-body" @ref="body">
        @if (Section == "Handbook")
        {
            @if (Page == null)
            {
                <div class="handbook-search">
                    <input class="form-control form-control-sm" type="search" placeholder="Search the handbook, the devices and this machine"
                           aria-label="Search the handbook" value="@query" @oninput="e => query = e.Value?.ToString()" />
                </div>
                @if (!string.IsNullOrWhiteSpace(query))
                {
                    var hits = Handbook.Search(query, Package);
                    @if (hits.Count == 0)
                    {
                        <p class="handbook-empty">Nothing matches “@query.Trim()”.</p>
                    }
                    <ul class="hits">
                        @foreach (var hit in hits)
                        {
                            <li>
                                <button class="hit" @onclick="() => Follow((hit.Kind, hit.Target))">
                                    <span class="hit-head"><span class="hit-title">@hit.Title</span><span class="hit-section silk">@hit.Section</span></span>
                                    <span class="hit-snippet">@hit.Snippet</span>
                                </button>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    @foreach (var group in Guides.All.GroupBy(g => g.Section))
                    {
                        <div class="toc-section silk">@group.Key</div>
                        <ol class="toc @(group.Key == "Start" ? "plain" : "")">
                            @foreach (var guide in group)
                            {
                                <li><button class="toc-link" @onclick="@(() => Open(("guide", guide.Id)))">@guide.Title</button></li>
                            }
                        </ol>
                    }
                    <div class="toc-section silk">@Handbook.ReferenceSection</div>
                    @foreach (var category in DeviceReference.ByCategory)
                    {
                        <div class="toc-group">@category.Key</div>
                        <ul class="toc devices">
                            @foreach (var type in category)
                            {
                                <li>
                                    <button class="toc-device" title="@type.Description" @onclick="@(() => Open(("reference", type.Type)))">
                                        <span class="toc-device-name">@type.Type</span>
                                        <span class="toc-device-what">@DeviceReference.Summary(type)</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                }
            }
            else
            {
                var (previous, next) = Neighbours(Page.Value);
                <div class="page-nav">
                    <button class="page-back" @onclick="() => Open(null)">‹ Contents</button>
                    <span class="grow"></span>
                    <span class="silk">@PageSection(Page.Value)</span>
                </div>
                <ReadmeView @key="@($"{Page.Value.Kind}/{Page.Value.Target}")" Markdown="@PageMarkdown(Page.Value)" OnLink="Follow" />
                <div class="page-steps">
                    @if (previous != null)
                    {
                        <button class="page-step" @onclick="() => Open(previous.Value.Link)"><small>Previous</small>@previous.Value.Title</button>
                    }
                    <span class="grow"></span>
                    @if (next != null)
                    {
                        <button class="page-step next" @onclick="() => Open(next.Value.Link)"><small>Next</small>@next.Value.Title</button>
                    }
                </div>
            }
        }
        else if (Section == "Machines")
        {
            <p class="examples-intro">Everything you change is kept in this browser, so you can switch machines and come back later. <strong>Export</strong> saves a machine as a file to keep or share, and <strong>Import…</strong> opens one.</p>
            var own = Workspace?.OwnPackages.ToList() ?? new List<MachinePackage>();
            <div class="machines-title silk">Your machines</div>
            @if (own.Count == 0)
            {
                <p class="machines-empty">None yet. <strong>New…</strong> starts one, from scratch or from a copy of an example.</p>
            }
            @foreach (var mine in own)
            {
                var current = mine.Name == Package.Name;
                <div class="example @(current ? "current" : "")">
                    <div class="example-head">
                        <span class="example-name">@mine.Name</span>
                        <span class="grow"></span>
                        @if (current)
                        {
                            <span class="example-open silk">open</span>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => Show("This machine"))">Read</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OnLoadPackage.InvokeAsync(mine.Name)">Load</button>
                        }
                        <button class="btn btn-sm btn-outline-secondary" title="Save it as a file" @onclick="() => OnExportPackage.InvokeAsync(mine.Name)">Export</button>
                        <button class="btn btn-sm btn-outline-danger" title="Remove it from this browser" @onclick="() => OnDeletePackage.InvokeAsync(mine.Name)">Delete</button>
                    </div>
                    <div class="example-description">@mine.Description</div>
                </div>
            }
            <div class="machines-title silk">Examples</div>
            <p class="machines-empty">Machines to take apart and start from. Change them as much as you like: <strong>Reset</strong> brings one back the way it ships.</p>
            @foreach (var level in BuiltInPackages.Levels)
            {
                var examples = BuiltInPackages.All.Where(p => BuiltInPackages.Level(p.Name) == level).ToList();
                var open = LevelOpen(level);
                <button class="level-toggle @(open ? "" : "collapsed")" title="@LevelHint(level)" @onclick="() => ToggleLevel(level)">
                    <i class="chev"></i>@LevelTitle(level) <span class="level-count">@examples.Count</span>
                </button>
                @if (!open) { continue; }
            @foreach (var example in examples)
            {
                var current = example.Name == Package.Name;
                var edited = Workspace?.IsEdited(example.Name) == true;
                <div class="example @(current ? "current" : "")">
                    <div class="example-head">
                        <span class="example-name">@example.Name</span>
                        @if (edited) { <span class="example-edited silk" title="You have changed it; the changes are kept in this browser">edited</span> }
                        <span class="grow"></span>
                        @if (current)
                        {
                            <span class="example-open silk">open</span>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => Show("This machine"))">Read</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OnLoadPackage.InvokeAsync(example.Name)">Load</button>
                        }
                        <button class="btn btn-sm btn-outline-secondary" title="Save it as a file, with your changes if it has any" @onclick="() => OnExportPackage.InvokeAsync(example.Name)">Export</button>
                        @if (edited)
                        {
                            <button class="btn btn-sm btn-outline-danger" title="Throw away your changes and bring it back the way it ships" @onclick="() => OnResetPackage.InvokeAsync(example.Name)">Reset</button>
                        }
                    </div>
                    <div class="example-description">@example.Description</div>
                </div>
            }
            }
            <div class="machines-title silk">Start over</div>
            <div class="start-over">
                <p class="machines-empty">Everything back the way it was on your first visit: your machines and your changes to the examples go, and so do the theme and the layout.</p>
                <button class="btn btn-sm btn-outline-danger" title="Forget everything ExµArch keeps in this browser, after asking" @onclick="() => OnStartOver.InvokeAsync()">Reset everything</button>
            </div>
        }
        else
        {
            <div class="machine-toolbar">
                <span class="silk">@Package.Name</span>
                <span class="machine-views">
                    <button class="machine-view @(machineView == "Note" ? "on" : "")" @onclick="@(() => ShowMachine("Note"))">Note</button>
                    <button class="machine-view @(machineView == "JSON" ? "on" : "")" title="The whole machine as one file, microcode included, kept in step with the editors" @onclick="@(() => ShowMachine("JSON"))">JSON @if ((JsonErrors?.Count ?? 0) > 0) { <span class="badge badge-danger ms-1">@JsonErrors.Count</span> }</button>
                </span>
                <span class="grow"></span>
                @if (machineView == "Note")
                {
                    @if (IsBuiltIn)
                    {
                        <span class="machine-hint">A built in example. Start your own with New…</span>
                    }
                    else
                    {
                        <button class="btn btn-sm @(editing ? "btn-primary" : "btn-outline-secondary")" @onclick="() => editing = !editing">@(editing ? "Done" : "Edit")</button>
                    }
                }
            </div>
            @if (machineView == "JSON")
            {
                <div class="machine-json">
                    <ErrorList Errors="@(JsonErrors ?? new List<string>())" />
                    <SourceEditorComponent Label="machine.json · microcode inline · synced with the editors" Value="@DefinitionJson" ValueChanged="OnJsonChanged" Rows="30" />
                </div>
            }
            else
            {
                <ReadmeView @key="@("machine" + Package.Name)" Markdown="@Package.Readme" Editing="editing" MarkdownChanged="SetReadme" OnLink="Follow"
                            Empty="@(IsBuiltIn ? "This machine has no note." : "No note yet. Use Edit to write what your machine is about.")" />
            }
        }
    </div>
</aside>

@code
{
    public static readonly string[] Sections = { "Handbook", "Machines", "This machine" };

    [Parameter] public MachinePackage Package { get; set; }
    [Parameter] public bool IsBuiltIn { get; set; }
    [Parameter] public string Section { get; set; } = "Handbook";
    [Parameter] public EventCallback<string> SectionChanged { get; set; }
    // The handbook page shown, as an exuarch: link kind (guide or reference) and target; null for the contents.
    [Parameter] public (string Kind, string Target)? Page { get; set; }
    [Parameter] public EventCallback<(string Kind, string Target)?> PageChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnLoadPackage { get; set; }
    // What is kept in the browser: the user's own packages, and which examples they have changed.
    [Parameter] public Workspace Workspace { get; set; }
    [Parameter] public EventCallback<string> OnResetPackage { get; set; }
    [Parameter] public EventCallback<string> OnDeletePackage { get; set; }
    [Parameter] public EventCallback<string> OnExportPackage { get; set; }
    [Parameter] public EventCallback OnStartOver { get; set; }
    [Parameter] public EventCallback OnReadmeChanged { get; set; }
    // The machine as JSON, which this machine's JSON view edits, and why the last edit did not parse.
    [Parameter] public string DefinitionJson { get; set; }
    [Parameter] public List<string> JsonErrors { get; set; }
    [Parameter] public EventCallback<string> OnJsonChanged { get; set; }
    // Every link, handbook pages included: the page decides where it goes.
    [Parameter] public EventCallback<(string Kind, string Target)> OnLink { get; set; }

    private ElementReference body;
    private bool editing;
    // This machine: its note, or its JSON.
    private string machineView = "Note";
    private string query;
    private (string Kind, string Target)? shownPage;
    private string shownSection;

    // Guides first, then the device reference: the order Previous and Next walk through.
    private static readonly Lazy<List<((string Kind, string Target) Link, string Title, string Section)>> Order = new(() =>
        Guides.All.Select(g => (("guide", g.Id), g.Title, g.Section))
            .Concat(DeviceReference.Types.Select(t => (("reference", t.Type), t.Type, Handbook.ReferenceSection)))
            .ToList());

    protected override void OnParametersSet()
    {
        if (IsBuiltIn || Section != "This machine") editing = false;
    }

    // A new page or section starts at the top.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shownPage != Page || shownSection != Section)
        {
            shownPage = Page;
            shownSection = Section;
            if (!firstRender) await JS.InvokeVoidAsync("exuarchReadme.scrollTop", body);
        }
    }

    // Which example groups are open. Simple starts open, and so does the group of the machine that is open.
    private readonly Dictionary<string, bool> levelOpen = new Dictionary<string, bool>();

    private bool LevelOpen(string level)
    {
        return levelOpen.TryGetValue(level, out var open) ? open : level == "simple" || BuiltInPackages.Level(Package?.Name) == level;
    }

    private void ToggleLevel(string level)
    {
        levelOpen[level] = !LevelOpen(level);
    }

    private static string LevelTitle(string level) => char.ToUpperInvariant(level[0]) + level.Substring(1);

    private static string LevelHint(string level) => level switch
    {
        "simple" => "One bus and a handful of registers: start here",
        "advanced" => "Register files, several buses, transport triggering, coprocessors and interrupts",
        _ => "Graphics pipelines, and one machine tuned until it is hard to read",
    };

    private void ShowMachine(string view)
    {
        machineView = view;
        editing = false;
    }

    private async Task Show(string section)
    {
        editing = false;
        Section = section;
        await SectionChanged.InvokeAsync(section);
    }

    private async Task Open((string Kind, string Target)? page)
    {
        Page = page;
        await PageChanged.InvokeAsync(page);
    }

    private Task Follow((string Kind, string Target) link)
    {
        return OnLink.InvokeAsync(link);
    }

    private static string PageMarkdown((string Kind, string Target) page)
    {
        if (page.Kind == "reference") return DeviceReference.Exists(page.Target) ? DeviceReference.Markdown(page.Target) : $"# {page.Target}\n\nThere is no such device type.";
        return Guides.Find(page.Target)?.Markdown ?? $"# {page.Target}\n\nThere is no such page.";
    }

    private static string PageSection((string Kind, string Target) page)
    {
        return page.Kind == "reference" ? Handbook.ReferenceSection : Guides.Find(page.Target)?.Section;
    }

    private static (((string Kind, string Target) Link, string Title)? Previous, ((string Kind, string Target) Link, string Title)? Next) Neighbours((string Kind, string Target) page)
    {
        var order = Order.Value;
        int index = order.FindIndex(p => p.Link == page);
        if (index < 0) return (null, null);
        var previous = index > 0 ? (order[index - 1].Link, order[index - 1].Title) : ((( string, string), string)?)null;
        var next = index < order.Count - 1 ? (order[index + 1].Link, order[index + 1].Title) : ((( string, string), string)?)null;
        return (previous, next);
    }

    private Task SetReadme(string markdown)
    {
        Package.Readme = markdown;
        return OnReadmeChanged.InvokeAsync();
    }
}
