@inject IJSRuntime JS

@if (Display != null)
{
    <div class="lcd-fit" @ref="fit">
    <div class="lcd" style="--cols:@Display.Columns">
        <div class="lcd-head">
            <span class="lcd-name">@Display.ID()</span>
            <span class="lcd-size">@Display.Columns × @Display.Rows · Latin-1</span>
        </div>
        <div class="lcd-screen">
            @for (int row = 0; row < Display.Rows; row++)
            {
                <div class="lcd-row">
                    @for (int column = 0; column < Display.Columns; column++)
                    {
                        var index = row * Display.Columns + column;
                        var value = Display.Cells[index];
                        <span class="lcd-cell @(index == Display.Cursor ? "cursor" : "") @(index == LastWritten ? "fresh" : "")"
                              @key="@(index == LastWritten ? $"{index}@{Cycle}" : index.ToString())" title="@($"{index}: {HexByte(value)}")">@CharacterDisplay.ToChar(value)</span>
                    }
                </div>
            }
        </div>
    </div>
    </div>
}

@code
{
    [Parameter]
    public CharacterDisplay Display { get; set; }

    [Parameter]
    public int LastWritten { get; set; } = -1;

    [Parameter]
    public int Cycle { get; set; }

    private ElementReference fit;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Display != null) await JS.InvokeVoidAsync("exuarchFit.observe", fit);
    }
}
