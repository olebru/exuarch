@using System.Runtime.InteropServices
@using Exuarch.Core
@inject IJSRuntime JS
@implements IDisposable

@if (Screen != null)
{
    <div class="screen @(actualSize ? "large" : "")" tabindex="-1" @ref="root" @onkeydown="OnKeyDown" @onclick="() => actualSize = false">
        <div class="screen-frame" @onclick:stopPropagation>
            <div class="screen-head">
                <span class="screen-name">@Screen.ID()</span>
                <span class="screen-info">@Framebuffer.Width × @Framebuffer.Height · @Screen.Kind · cursor <span class="screen-num">@Screen.X</span>, <span class="screen-num">@Screen.Y</span></span>
                <span class="screen-hint">@(actualSize ? "actual size · click or Esc to close" : "click to view at actual size")</span>
            </div>
            <canvas id="@canvasId" width="@Framebuffer.Width" height="@Framebuffer.Height" class="screen-canvas" @onclick="() => actualSize = !actualSize"></canvas>
        </div>
    </div>
}

@code
{
    [Parameter]
    public IScreen Screen { get; set; }

    private readonly string canvasId = "fb-" + Guid.NewGuid().ToString("N");
    private IScreen drawn;
    private bool actualSize;
    private bool focusedActualSize;
    private ElementReference root;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") actualSize = false;
    }

    private static readonly HashSet<FramebufferView> onPage = new HashSet<FramebufferView>();
    protected override void OnInitialized() { onPage.Add(this); }
    public void Dispose() { onPage.Remove(this); }

    public static void ShowChanges()
    {
        foreach (var view in onPage) view.SendChanges();
    }

    private void SendChanges()
    {
        if (Screen == null || !ReferenceEquals(drawn, Screen)) return;
        if (Screen.TakeDirtyRegion() is var (x, y, width, height)) Draw(x, y, width, height);
    }

    private void Draw(int x, int y, int width, int height)
    {
        var rows = MemoryMarshal.AsBytes(Screen.Words.AsSpan(y * Framebuffer.Width, height * Framebuffer.Width));
        ScreenInterop.Draw(canvasId, x, y, width, height, rows, Screen.IsDepth);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Screen == null) return;
        await FocusActualSizeViewWhenItOpens();
        if (firstRender || !ReferenceEquals(drawn, Screen))
        {
            drawn = Screen;
            Screen.TakeDirtyRegion();
            Draw(0, 0, Framebuffer.Width, Framebuffer.Height);
            return;
        }
        SendChanges();
    }

    private async Task FocusActualSizeViewWhenItOpens()
    {
        if (actualSize == focusedActualSize) return;
        focusedActualSize = actualSize;
        if (actualSize) await JS.InvokeVoidAsync("exuarchEditor.focus", root);
    }
}
